{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthesis sidecar runtime prebuild result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "workflow",
    "runId",
    "requestId",
    "sourceSha",
    "buildFingerprint",
    "aggregate",
    "prebuildBranch",
    "prebuildCommit",
    "setPath",
    "cache"
  ],
  "properties": {
    "schema": { "const": "synthesis-sidecar-runtime-prebuild-result.v2" },
    "repository": { "type": "string" },
    "workflow": { "const": "prebuild-synthesis-sidecar-runtime.yml" },
    "runId": { "type": "integer", "minimum": 1 },
    "requestId": { "type": "string" },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "buildFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "aggregate": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prebuildBranch": { "const": "synthesis-sidecar-runtime-prebuilds" },
    "prebuildCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "setPath": { "type": "string" },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cacheHits", "cacheMisses", "cacheSourceRuns"],
      "properties": {
        "cacheHits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "win32-x64",
              "darwin-x64",
              "darwin-arm64",
              "linux-x86",
              "linux-x64",
              "linux-arm",
              "linux-arm64"
            ]
          }
        },
        "cacheMisses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "win32-x64",
              "darwin-x64",
              "darwin-arm64",
              "linux-x86",
              "linux-x64",
              "linux-arm",
              "linux-arm64"
            ]
          }
        },
        "cacheSourceRuns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
