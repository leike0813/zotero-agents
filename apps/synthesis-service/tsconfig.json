{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "../../packages/synthesis-contracts/src/common.ts",
    "../../packages/synthesis-contracts/src/sidecarLifecycle.ts",
    "../../packages/synthesis-contracts/src/sidecarSystem.ts",
    "../../packages/synthesis-contracts/src/workbench.ts",
    "../../packages/synthesis-application/src/index.ts",
    "../../packages/synthesis-repository/src/index.ts"
  ]
}
