{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/contracts/v1/lifecycle.schema.json",
  "title": "Synthesis sidecar lifecycle v1 normalized DTOs",
  "oneOf": [
    { "$ref": "#/$defs/launchConfig" },
    { "$ref": "#/$defs/owner" },
    { "$ref": "#/$defs/lease" },
    { "$ref": "#/$defs/discovery" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capability": {
      "enum": [
        "system.handshake",
        "system.shutdown",
        "workbench.chrome.read",
        "topics.canonical.inspect",
        "compute.citation_graph_layout",
        "compute.citation_graph_metrics",
        "compute.citation_graph_build",
        "compute.citation_graph_build_transfer"
      ]
    },
    "launchConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "profileRuntimeRoot",
        "runtimeRootId",
        "dataRootId",
        "bundleId",
        "nodeVersion",
        "serviceVersion",
        "protocolVersion",
        "schemaVersion",
        "supervisorInstanceId",
        "leaseNonce",
        "clientToken",
        "lifecycleToken",
        "mutationEnabled",
        "port"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-launch-config.v1" },
        "profileId": { "$ref": "#/$defs/hash" },
        "profileRuntimeRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "runtimeRootId": { "$ref": "#/$defs/hash" },
        "dataRootId": { "$ref": "#/$defs/hash" },
        "bundleId": { "$ref": "#/$defs/hash" },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "serviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": { "const": "synthesis-sidecar.v1" },
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "supervisorInstanceId": { "$ref": "#/$defs/id" },
        "leaseNonce": { "$ref": "#/$defs/id" },
        "clientToken": { "type": "string", "minLength": 32, "maxLength": 256 },
        "lifecycleToken": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "mutationEnabled": { "const": false },
        "port": { "const": 0 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "supervisorInstanceId",
        "serviceInstanceId",
        "leaseNonce",
        "pid",
        "createdAtMs"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-owner.v1" },
        "profileId": { "$ref": "#/$defs/hash" },
        "supervisorInstanceId": { "$ref": "#/$defs/id" },
        "serviceInstanceId": { "$ref": "#/$defs/id" },
        "leaseNonce": { "$ref": "#/$defs/id" },
        "pid": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
        "createdAtMs": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "supervisorInstanceId",
        "leaseNonce",
        "updatedAtMs"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-lease.v1" },
        "profileId": { "$ref": "#/$defs/hash" },
        "supervisorInstanceId": { "$ref": "#/$defs/id" },
        "leaseNonce": { "$ref": "#/$defs/id" },
        "updatedAtMs": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "supervisorInstanceId",
        "serviceInstanceId",
        "bundleId",
        "nodeVersion",
        "serviceVersion",
        "protocolVersion",
        "schemaVersion",
        "runtimeRootId",
        "dataRootId",
        "host",
        "port",
        "pid",
        "lifecycleState",
        "tokenLocator",
        "capabilities"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-discovery.v1" },
        "profileId": { "$ref": "#/$defs/hash" },
        "supervisorInstanceId": { "$ref": "#/$defs/id" },
        "serviceInstanceId": { "$ref": "#/$defs/id" },
        "bundleId": { "$ref": "#/$defs/hash" },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "serviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": { "const": "synthesis-sidecar.v1" },
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runtimeRootId": { "$ref": "#/$defs/hash" },
        "dataRootId": { "$ref": "#/$defs/hash" },
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
        "lifecycleState": { "const": "ready" },
        "tokenLocator": { "const": "supervisor-session" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    }
  }
}
