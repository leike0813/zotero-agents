        "code": {
          "enum": [
            "invalid_request",
            "worker_canceled",
            "worker_result_invalid"
          ]
        }
      }
    },
    "metricsWorkerMessage": {
      "oneOf": [
        { "$ref": "#/$defs/metricsWorkerRun" },
        { "$ref": "#/$defs/metricsWorkerCancel" },
        { "$ref": "#/$defs/metricsWorkerResult" },
        { "$ref": "#/$defs/metricsWorkerFailure" }
      ]
    },
    "workerPageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "pageIndex", "rowCount", "byteLength", "sha256"],
      "properties": {
        "section": {
          "enum": [
            "entries",
            "aliases",
            "abbrev",
            "concepts",
            "senses",
            "labels",
            "nodes",
            "edges",
            "warnings",
            "tags",
            "search",
            "validationWarnings",
            "overlayEntries",
            "matches",
            "roots",
            "unplaced",
            "papers",
            "references",
            "canonicals",
            "clusters",
            "actions",
            "diagnostics",
            "libraryNodes",
            "resolvedEdges",
            "aggregateEdges",
            "sourceOwnership",
            "incomingGroups",
            "lightMetrics",
            "manifest",
            "artifact",
            "sections",
            "currentManifest",
            "currentSections",
            "patchManifest",
            "changedSections",
            "nextSectionHashes",
            "mismatches",
            "errors"
          ]
        },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 255 },
        "rowCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "byteLength": { "type": "integer", "minimum": 2, "maximum": 4194304 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "deterministicWorkerRunBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "taskId",
        "operation",
        "requestHash",
        "header"
      ],
      "properties": {
        "protocol": { "const": "synthesis-rust-worker.v1" },
        "type": { "const": "run_begin" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "operation": {
          "enum": [
            "tag_vocabulary_validate.v1",
            "tag_vocabulary_index.v1",
            "concept_kb_index.v1",
            "concept_kb_query.v1",
            "topic_graph_index.v1",
            "reference_binding.v1",
            "reference_canonical_dedupe.v1",
            "topic_manifest_validate.v1",
            "topic_artifact_assemble.v1",
            "topic_artifact_validate.v1",
            "topic_section_patch.v1",
            "citation_graph_build.v1",
            "citation_graph_build_transfer.v1"
          ]
        },
        "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "header": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "deterministicWorkerResultBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "taskId",
        "operation",
        "requestHash",
        "header"
      ],
      "properties": {
        "protocol": { "const": "synthesis-rust-worker.v1" },
        "type": { "const": "result_begin" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "header": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "deterministicWorkerPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "taskId", "descriptor", "rows"],
      "properties": {
        "protocol": { "const": "synthesis-rust-worker.v1" },
        "type": { "enum": ["input_page", "result_page"] },
        "taskId": { "$ref": "#/$defs/identifier" },
        "descriptor": { "$ref": "#/$defs/workerPageDescriptor" },
        "rows": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "deterministicWorkerAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "taskId", "section", "pageIndex"],
      "properties": {
        "protocol": { "const": "synthesis-rust-worker.v1" },
        "type": { "enum": ["input_ack", "result_ack"] },
        "taskId": { "$ref": "#/$defs/identifier" },
        "section": { "$ref": "#/$defs/identifier" },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "deterministicWorkerComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "taskId"],
      "properties": {
        "protocol": { "const": "synthesis-rust-worker.v1" },
        "type": { "enum": ["input_complete", "result_complete"] },
        "taskId": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "result_complete" } } },
          "then": {
            "required": ["operation", "requestHash"],
            "properties": {
              "operation": { "$ref": "#/$defs/identifier" },
              "requestHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "deterministicWorkerMessage": {
      "oneOf": [
        { "$ref": "#/$defs/deterministicWorkerRunBegin" },
        { "$ref": "#/$defs/deterministicWorkerResultBegin" },
        { "$ref": "#/$defs/deterministicWorkerPage" },
        { "$ref": "#/$defs/deterministicWorkerAck" },
        { "$ref": "#/$defs/deterministicWorkerComplete" },
        { "$ref": "#/$defs/metricsWorkerCancel" },
        { "$ref": "#/$defs/metricsWorkerFailure" }
      ]
    },
    "versionedDomainRequest": {
      "type": "object",
      "required": ["contractVersion", "algorithmVersion"],
      "properties": {
        "contractVersion": { "$ref": "#/$defs/string" },
        "algorithmVersion": { "$ref": "#/$defs/string" }
      },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "versionedDomainResult": {
      "type": "object",
      "required": ["contractVersion", "algorithmVersion"],
      "properties": {
        "contractVersion": { "$ref": "#/$defs/string" },
        "algorithmVersion": { "$ref": "#/$defs/string" }
      },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  }
