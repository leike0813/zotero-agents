{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/contracts/v1/compute.schema.json",
  "title": "Synthesis service and worker compute v1 normalized DTOs",
  "oneOf": [
    { "$ref": "#/$defs/layoutRequest" },
    { "$ref": "#/$defs/layoutResult" },
    { "$ref": "#/$defs/metricsRequest" },
    { "$ref": "#/$defs/metricsResult" },
    { "$ref": "#/$defs/graphBuildRequest" },
    { "$ref": "#/$defs/graphBuildResult" },
    { "$ref": "#/$defs/tagVocabularyValidationRequest" },
    { "$ref": "#/$defs/tagVocabularyValidationResult" },
    { "$ref": "#/$defs/tagVocabularyIndexRequest" },
    { "$ref": "#/$defs/tagVocabularyIndexResult" },
    { "$ref": "#/$defs/conceptKbIndexRequest" },
    { "$ref": "#/$defs/conceptKbIndexResult" },
    { "$ref": "#/$defs/conceptKbQueryRequest" },
    { "$ref": "#/$defs/conceptKbQueryResult" },
    { "$ref": "#/$defs/topicGraphIndexRequest" },
    { "$ref": "#/$defs/topicGraphIndexResult" }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "string": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodeKind": {
      "enum": ["library_paper", "external_reference", "unresolved_reference"]
    },
    "layoutRequestNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "initialX", "initialY"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/nodeKind" },
        "title": { "$ref": "#/$defs/string" },
        "year": { "$ref": "#/$defs/string" },
        "initialX": { "type": "number" },
        "initialY": { "type": "number" }
      }
    },
    "layoutRequestEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "source", "target"],
      "properties": {
        "edgeId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" }
      }
    },
    "layoutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphHash", "algorithm", "nodes", "edges"],
      "properties": {
        "graphHash": { "$ref": "#/$defs/string" },
        "algorithm": { "enum": ["force", "radial", "components"] },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/layoutRequestNode" }
        },
        "edges": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/layoutRequestEdge" }
        }
      }
    },
    "layoutResultNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "x", "y"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "layoutResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphHash",
        "algorithm",
        "layoutEngine",
        "layoutVersion",
        "params",
        "nodes"
      ],
      "properties": {
        "graphHash": { "$ref": "#/$defs/string" },
        "algorithm": { "enum": ["force", "radial", "components"] },
        "layoutEngine": {
          "enum": ["forceatlas2-rust", "radial-rust", "components-rust"]
        },
        "layoutVersion": { "const": 2 },
        "params": { "$ref": "#/$defs/jsonObject" },
        "nodes": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/layoutResultNode" }
        }
      }
    },
    "metricsRequestNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/nodeKind" },
        "libraryId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "itemKey": { "$ref": "#/$defs/string" },
        "title": { "$ref": "#/$defs/string" },
        "year": { "$ref": "#/$defs/string" }
      }
    },
    "metricsRequestEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "source", "target", "mentionCount"],
      "properties": {
        "edgeId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "mentionCount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "metricsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphHash", "nodes", "edges"],
      "properties": {
        "graphHash": { "$ref": "#/$defs/string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/metricsRequestNode" }
        },
        "edges": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/metricsRequestEdge" }
        }
      }
    },
    "metricsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "internalInDegree",
        "internalOutDegree",
        "externalReferenceCount",
        "unresolvedReferenceCount",
        "internalPagerank",
        "componentId",
        "componentSize",
        "isIsolated",
        "ageNorm",
        "recencyNorm",
        "inDegreeNorm",
        "outDegreeNorm",
        "pagerankNorm",
        "foundationScore",
        "frontierScore",
        "synthesisRoleHints"
      ],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "paperRef": { "$ref": "#/$defs/string" },
        "itemKey": { "$ref": "#/$defs/string" },
        "title": { "$ref": "#/$defs/string" },
        "year": { "$ref": "#/$defs/string" },
        "internalInDegree": { "$ref": "#/$defs/safeInteger" },
        "internalOutDegree": { "$ref": "#/$defs/safeInteger" },
        "externalReferenceCount": { "$ref": "#/$defs/safeInteger" },
        "unresolvedReferenceCount": { "$ref": "#/$defs/safeInteger" },
        "internalPagerank": { "type": "number" },
        "componentId": { "$ref": "#/$defs/string" },
        "componentSize": { "$ref": "#/$defs/safeInteger" },
        "isIsolated": { "type": "boolean" },
        "ageNorm": { "type": "number" },
        "recencyNorm": { "type": "number" },
        "inDegreeNorm": { "type": "number" },
        "outDegreeNorm": { "type": "number" },
        "pagerankNorm": { "type": "number" },
        "foundationScore": { "type": "number" },
        "frontierScore": { "type": "number" },
        "synthesisRoleHints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "core",
              "external-heavy",
              "foundation",
              "frontier",
              "isolated"
            ]
          }
        }
      }
    },
    "metricsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphHash",
        "metricsVersion",
        "params",
        "graphYear",
        "libraryNodeMetrics",
        "diagnostics"
      ],
      "properties": {
        "graphHash": { "$ref": "#/$defs/string" },
        "metricsVersion": { "const": 2 },
        "params": { "$ref": "#/$defs/jsonObject" },
        "graphYear": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1500, "maximum": 2199 }
          ]
        },
        "libraryNodeMetrics": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/metricsNode" }
        },
        "diagnostics": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "graphBuildScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceIds"],
      "properties": {
        "kind": { "enum": ["full", "source_slice"] },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "graphBuildLibraryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "authors", "aliases"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/string" },
        "year": { "$ref": "#/$defs/string" },
        "authors": { "type": "array", "items": { "$ref": "#/$defs/string" } },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/string" }
        }
      }
    },
    "graphBuildReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "edgeId",
        "sourceId",
        "targetId",
        "targetKind",
        "targetAuthors",
        "targetAliases",
        "roles",
        "weight"
      ],
      "properties": {
        "referenceId": { "$ref": "#/$defs/identifier" },
        "edgeId": { "$ref": "#/$defs/identifier" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceRef": { "$ref": "#/$defs/string" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "targetKind": { "$ref": "#/$defs/nodeKind" },
        "targetTitle": { "$ref": "#/$defs/string" },
        "targetYear": { "$ref": "#/$defs/string" },
        "targetAuthors": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "targetAliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/string" } },
        "weight": { "type": "number" }
      }
    },
    "graphBuildRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "scope",
        "rolePriority",
        "libraryNodes",
        "references"
      ],
      "properties": {
        "contractVersion": { "const": "synthesis-citation-graph-build.v1" },
        "scope": { "$ref": "#/$defs/graphBuildScope" },
        "rolePriority": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/string" }
        },
        "libraryNodes": {
          "type": "array",
          "maxItems": 25000,
          "items": { "$ref": "#/$defs/graphBuildLibraryNode" }
        },
        "references": {
          "type": "array",
          "maxItems": 1250000,
          "items": { "$ref": "#/$defs/graphBuildReference" }
        }
      }
    },
    "graphBuildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "scope",
        "nodes",
        "resolvedEdges",
        "aggregateEdges",
        "sourceOwnership",
        "incomingGroups",
        "lightMetrics",
        "diagnostics"
      ],
      "properties": {
        "contractVersion": { "const": "synthesis-citation-graph-build.v1" },
        "scope": { "$ref": "#/$defs/graphBuildScope" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "resolvedEdges": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "aggregateEdges": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "sourceOwnership": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "incomingGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "lightMetrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "diagnostics": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "stringRecord": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/string" }
    },
    "tagVocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "facet", "aliases", "abbrev"],
      "properties": {
        "tag": { "$ref": "#/$defs/string" },
        "facet": { "$ref": "#/$defs/string" },
        "note": { "$ref": "#/$defs/string" },
        "deprecated": { "type": "boolean" },
        "replacement": { "$ref": "#/$defs/string" },
        "aliases": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        },
        "abbrev": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        }
      }
    },
    "tagVocabularyProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tagPattern", "maxTagLength", "facets"],
      "properties": {
        "version": { "$ref": "#/$defs/string" },
        "tagPattern": { "$ref": "#/$defs/string" },
        "maxTagLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "facets": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        }
      }
    },
    "tagVocabularyWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/string" },
        "severity": { "enum": ["warning", "error"] },
        "tag": { "$ref": "#/$defs/string" },
        "message": { "$ref": "#/$defs/string" }
      }
    },
    "tagVocabularySearchRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "normalized", "facet", "aliases", "abbrev"],
      "properties": {
        "tag": { "$ref": "#/$defs/string" },
        "normalized": { "$ref": "#/$defs/string" },
        "facet": { "$ref": "#/$defs/string" },
        "aliases": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        },
        "abbrev": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        }
      }
    },
    "conceptKbConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptId",
        "label",
        "aliases",
        "conceptType",
        "domain",
        "status"
      ],
      "properties": {
        "conceptId": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/string" },
        "aliases": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/string" }
        },
        "conceptType": { "$ref": "#/$defs/string" },
        "domain": { "$ref": "#/$defs/string" },
        "status": { "enum": ["active", "review", "deprecated"] },
        "shortDefinition": { "$ref": "#/$defs/string" },
        "definition": { "$ref": "#/$defs/string" }
      }
    },
    "conceptKbSense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["senseId", "conceptId", "label", "confidence"],
      "properties": {
        "senseId": { "$ref": "#/$defs/identifier" },
        "conceptId": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/string" },
        "shortDefinition": { "$ref": "#/$defs/string" },
        "definition": { "$ref": "#/$defs/string" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "conceptKbAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliasId",
        "alias",
        "normalized",
        "conceptId",
        "status",
        "confidence"
      ],
      "properties": {
        "aliasId": { "$ref": "#/$defs/identifier" },
        "alias": { "$ref": "#/$defs/string" },
        "normalized": { "$ref": "#/$defs/string" },
        "conceptId": { "$ref": "#/$defs/identifier" },
        "senseId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["active", "review", "deprecated"] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "conceptKbSearchRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "label", "normalized", "conceptType", "domain"],
      "properties": {
        "conceptId": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/string" },
        "normalized": { "$ref": "#/$defs/string" },
        "conceptType": { "$ref": "#/$defs/string" },
        "domain": { "$ref": "#/$defs/string" }
      }
    },
    "conceptKbOverlayEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "alias", "label", "confidence"],
      "properties": {
        "conceptId": { "$ref": "#/$defs/identifier" },
        "senseId": { "$ref": "#/$defs/identifier" },
        "alias": { "$ref": "#/$defs/string" },
        "label": { "$ref": "#/$defs/string" },
        "shortDefinition": { "$ref": "#/$defs/string" },
        "definition": { "$ref": "#/$defs/string" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "conceptKbQueryAliasMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliasId", "conceptId"],
      "properties": {
        "aliasId": { "$ref": "#/$defs/identifier" },
        "conceptId": { "$ref": "#/$defs/identifier" }
      }
    },
    "conceptKbQueryMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "exactConceptIds",
        "aliasMatches",
        "senseIds",
        "ambiguous"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/string" },
        "exactConceptIds": {
          "type": "array",
          "maxItems": 25000,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "aliasMatches": {
          "type": "array",
          "maxItems": 250000,
          "items": { "$ref": "#/$defs/conceptKbQueryAliasMatch" }
        },
        "senseIds": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "ambiguous": { "type": "boolean" }
      }
    },
    "topicGraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "isRoot"],
      "properties": {
        "topicId": { "$ref": "#/$defs/identifier" },
        "isRoot": { "type": "boolean" },
        "level": { "enum": ["top", "normal"] },
        "definitionStatus": {
          "enum": ["has_synthesis", "placeholder", "deleted", "stale"]
        }
      }
    },
    "topicGraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "sourceTopicId",
        "targetTopicId",
        "relation",
        "status"
      ],
      "properties": {
        "edgeId": { "$ref": "#/$defs/identifier" },
        "sourceTopicId": { "$ref": "#/$defs/identifier" },
        "targetTopicId": { "$ref": "#/$defs/identifier" },
        "relation": {
          "enum": [
            "broader_than",
            "related_to",
            "overlaps_with",
            "contrasts_with"
          ]
        },
        "status": {
          "enum": ["suggested", "confirmed", "rejected", "stale", "deleted"]
        }
      }
    },
    "tagVocabularyValidationRequest": {
      "allOf": [
        { "$ref": "#/$defs/versionedDomainRequest" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "algorithmVersion",
            "entries",
            "aliases",
            "abbrev",
            "protocol"
          ],
          "properties": {
            "contractVersion": { "const": "synthesis-tag-vocabulary.v1" },
            "algorithmVersion": { "const": "tag-vocabulary-validation.v1" },
            "entries": {
              "type": "array",
              "maxItems": 25000,
              "items": { "$ref": "#/$defs/tagVocabularyEntry" }
            },
            "aliases": { "$ref": "#/$defs/stringRecord" },
            "abbrev": { "$ref": "#/$defs/stringRecord" },
            "protocol": { "$ref": "#/$defs/tagVocabularyProtocol" }
          }
        }
      ]
    },
    "tagVocabularyValidationResult": {
      "allOf": [
        { "$ref": "#/$defs/versionedDomainResult" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "algorithmVersion", "warnings"],
          "properties": {
            "contractVersion": { "const": "synthesis-tag-vocabulary.v1" },
            "algorithmVersion": { "const": "tag-vocabulary-validation.v1" },
            "warnings": {
              "type": "array",
              "items": { "$ref": "#/$defs/tagVocabularyWarning" }
            }
          }
        }
      ]
    },
    "tagVocabularyIndexRequest": {
      "allOf": [
        { "$ref": "#/$defs/versionedDomainRequest" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "algorithmVersion",
            "entries",
            "aliases",
            "abbrev",
            "protocol",
            "sourceManifestHash",
            "rebuiltAt"
          ],
          "properties": {
            "contractVersion": { "const": "synthesis-tag-vocabulary.v1" },
            "algorithmVersion": { "const": "tag-vocabulary-index.v1" },
            "entries": {
              "type": "array",
              "maxItems": 25000,
              "items": { "$ref": "#/$defs/tagVocabularyEntry" }
            },
            "aliases": { "$ref": "#/$defs/stringRecord" },
            "abbrev": { "$ref": "#/$defs/stringRecord" },
            "protocol": { "$ref": "#/$defs/tagVocabularyProtocol" },
            "sourceManifestHash": { "$ref": "#/$defs/string" },
            "rebuiltAt": { "$ref": "#/$defs/string" }
          }
        }
      ]
    },
    "tagVocabularyIndexResult": {
      "allOf": [
        { "$ref": "#/$defs/versionedDomainResult" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "algorithmVersion",
            "schemaVersion",
            "sourceManifestHash",
            "rebuiltAt",
            "tags",
            "aliases",
            "abbrev",
            "search",
            "validationWarnings"
          ],
          "properties": {
            "contractVersion": { "const": "synthesis-tag-vocabulary.v1" },
            "algorithmVersion": { "const": "tag-vocabulary-index.v1" },
            "schemaVersion": { "const": "1.0.0" },
            "sourceManifestHash": { "$ref": "#/$defs/string" },
            "rebuiltAt": { "$ref": "#/$defs/string" },
            "tags": { "type": "array", "items": { "$ref": "#/$defs/string" } },
            "aliases": { "$ref": "#/$defs/stringRecord" },
            "abbrev": { "$ref": "#/$defs/stringRecord" },
            "search": {
