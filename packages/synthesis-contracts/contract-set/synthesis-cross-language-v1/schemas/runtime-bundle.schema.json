{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/contracts/v1/runtime-bundle.schema.json",
  "title": "Frozen Node runtime bundle and pointer v1 oracle",
  "oneOf": [
    { "$ref": "#/$defs/bundleManifest" },
    { "$ref": "#/$defs/pointer" }
  ],
  "$defs": {
    "sha256Hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._+/-]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "executable"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "executable": { "type": "boolean" }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "sha256", "signature", "platformSignature"],
      "properties": {
        "archive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "signature": { "const": "verified" },
        "platformSignature": { "enum": ["verified", "not-applicable"] }
      }
    },
    "bundleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "bundleId",
        "nodeVersion",
        "serviceVersion",
        "protocolVersion",
        "target",
        "buildFingerprint",
        "upstream",
        "executable",
        "entrypoint",
        "files"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-runtime-bundle.v1" },
        "bundleId": { "$ref": "#/$defs/sha256Hex" },
        "nodeVersion": { "const": "24.18.0" },
        "serviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "protocolVersion": { "const": "synthesis-sidecar.v1" },
        "target": {
          "enum": [
            "win32-x64",
            "darwin-x64",
            "darwin-arm64",
            "linux-x64",
            "linux-arm64"
          ]
        },
        "buildFingerprint": { "$ref": "#/$defs/sha256Hex" },
        "upstream": { "$ref": "#/$defs/upstream" },
        "executable": { "$ref": "#/$defs/relativePath" },
        "entrypoint": { "$ref": "#/$defs/relativePath" },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bundleId"],
      "properties": {
        "schema": { "const": "synthesis-sidecar-runtime-pointer.v1" },
        "bundleId": { "$ref": "#/$defs/sha256Hex" }
      }
    }
  }
}
