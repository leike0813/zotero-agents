{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/contracts/v1/system.schema.json",
  "title": "Synthesis sidecar system v1 normalized DTOs",
  "oneOf": [
    { "$ref": "#/$defs/callRequest" },
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/handshakePayload" },
    { "$ref": "#/$defs/handshakeResult" },
    { "$ref": "#/$defs/shutdownResult" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "sha256Hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capability": {
      "enum": [
        "system.handshake",
        "system.shutdown",
        "workbench.chrome.read",
        "topics.canonical.inspect",
        "compute.citation_graph_layout",
        "compute.citation_graph_metrics",
        "compute.citation_graph_build",
        "compute.citation_graph_build_transfer"
      ]
    },
    "callRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "requestId",
        "profileId",
        "capability",
        "payload"
      ],
      "properties": {
        "protocol": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payload": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "computePoolSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "active", "queued", "restartCount", "failureCount"],
      "properties": {
        "state": { "enum": ["idle", "busy", "degraded", "stopping"] },
        "active": { "enum": [0, 1] },
        "queued": { "type": "integer", "minimum": 0, "maximum": 2 },
        "restartCount": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "failureCount": { "$ref": "#/$defs/safeNonNegativeInteger" }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "state", "schemaVersion", "repositoryId"],
      "properties": {
        "mode": { "const": "isolated_shadow" },
        "state": { "enum": ["ready", "stopping"] },
        "schemaVersion": { "const": "synthesis-repository-foundation.v2" },
        "repositoryId": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "canonicalStoreSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "schemaVersion", "storeId"],
      "properties": {
        "state": { "enum": ["ready", "stopping", "repair_required"] },
        "schemaVersion": { "const": "synthesis-topic-canonical-store.v1" },
        "storeId": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "transferSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sessions", "stagedBytes"],
      "properties": {
        "state": { "enum": ["idle", "active", "stopping"] },
        "sessions": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "stagedBytes": { "$ref": "#/$defs/safeNonNegativeInteger" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "protocol",
        "serviceVersion",
        "serviceInstanceId",
        "supervisorInstanceId",
        "bundleId",
        "lifecycleState",
        "repository",
        "canonicalStore",
        "computePool",
        "citationGraphTransfer"
      ],
      "properties": {
        "status": { "const": "ok" },
        "protocol": { "const": "synthesis-sidecar.v1" },
        "serviceVersion": { "type": "string", "minLength": 1 },
        "serviceInstanceId": { "type": "string", "minLength": 1 },
        "supervisorInstanceId": { "type": "string", "minLength": 1 },
        "bundleId": { "type": "string", "minLength": 1 },
        "lifecycleState": { "enum": ["starting", "ready", "stopping"] },
        "repository": { "$ref": "#/$defs/repositorySnapshot" },
        "canonicalStore": { "$ref": "#/$defs/canonicalStoreSnapshot" },
        "computePool": { "$ref": "#/$defs/computePoolSnapshot" },
        "citationGraphTransfer": { "$ref": "#/$defs/transferSnapshot" }
      }
    },
    "handshakePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bundleId", "supervisorInstanceId"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "bundleId": { "type": "string", "minLength": 1 },
        "supervisorInstanceId": { "type": "string", "minLength": 1 }
      }
    },
    "handshakeResult": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "serviceVersion",
            "serviceInstanceId",
            "supervisorInstanceId",
            "bundleId",
            "nodeVersion",
            "profileId",
            "schemaVersion",
            "runtimeRootId",
            "dataRootId",
            "capabilities",
            "mutationEnabled",
            "lifecycleState",
            "repository",
            "canonicalStore",
            "computePool",
            "citationGraphTransfer"
          ],
          "properties": {
            "protocol": { "const": "synthesis-sidecar.v1" },
            "serviceVersion": { "type": "string", "minLength": 1 },
            "serviceInstanceId": { "type": "string", "minLength": 1 },
            "supervisorInstanceId": { "type": "string", "minLength": 1 },
            "bundleId": { "type": "string", "minLength": 1 },
            "nodeVersion": { "type": "string", "minLength": 1 },
            "profileId": { "type": "string", "minLength": 1 },
            "schemaVersion": { "type": "string", "minLength": 1 },
            "runtimeRootId": { "type": "string", "minLength": 1 },
            "dataRootId": { "type": "string", "minLength": 1 },
            "capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/capability" },
              "uniqueItems": true
            },
            "mutationEnabled": { "const": false },
            "lifecycleState": { "const": "ready" },
            "repository": { "$ref": "#/$defs/repositorySnapshot" },
            "canonicalStore": { "$ref": "#/$defs/canonicalStoreSnapshot" },
            "computePool": { "$ref": "#/$defs/computePoolSnapshot" },
            "citationGraphTransfer": { "$ref": "#/$defs/transferSnapshot" }
          }
        }
      ]
    },
    "shutdownResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "lifecycleState"],
      "properties": {
        "accepted": { "const": true },
        "lifecycleState": { "const": "stopping" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "requestId",
        "serviceInstanceId",
        "data",
        "diagnostics"
      ],
      "properties": {
        "ok": { "const": true },
        "requestId": { "type": "string" },
        "serviceInstanceId": { "type": "string" },
        "data": { "$ref": "#/$defs/jsonObject" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonObject" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "requestId", "serviceInstanceId", "error"],
      "properties": {
        "ok": { "const": false },
        "requestId": { "type": "string" },
        "serviceInstanceId": { "type": "string" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "response": {
      "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/failure" }]
    }
  }
}
