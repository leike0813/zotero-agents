{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/client-artifact-library-debug.schema.json",
  "$defs": {
    "OptionalEmptyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "object", "additionalProperties": false }
        }
      }
    },
    "String": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "Strings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/String" }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "$ref": "#/$defs/String" },
        "severity": { "enum": ["info", "warning", "error"] }
      }
    },
    "DebugPageRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "type": "string", "maxLength": 128 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ArtifactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_refs"],
      "properties": {
        "paper_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/String" }
        },
        "artifact_types": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "digest",
              "references",
              "citation_analysis",
              "literature_score"
            ]
          }
        }
      }
    },
    "ArtifactFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/String" }
        },
        "artifact_types": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "digest",
              "references",
              "citation_analysis",
              "literature_score"
            ]
          }
        }
      }
    },
    "LiteratureQuality": {
      "$ref": "reverse-host.schema.json#/$defs/LiteratureQuality"
    },
    "ArtifactRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_ref",
        "artifact_type",
        "payload_type",
        "status",
        "diagnostics",
        "payload_types_seen"
      ],
      "properties": {
        "paper_ref": { "$ref": "#/$defs/String" },
        "artifact_type": {
          "enum": [
            "digest",
            "references",
            "citation_analysis",
            "literature_score"
          ]
        },
        "payload_type": { "type": "string", "maxLength": 4096 },
        "status": {
          "enum": ["available", "missing", "invalid", "unavailable"]
        },
        "payload_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "payload": { "$ref": "common.schema.json#/$defs/opaqueCanonicalJson" },
        "markdown": { "type": "string", "maxLength": 8388608 },
        "decoded_text": { "type": "string", "maxLength": 8388608 },
        "literature_quality": { "$ref": "#/$defs/LiteratureQuality" },
        "payload_types_seen": { "$ref": "#/$defs/Strings" },
        "diagnostics": { "$ref": "#/$defs/Strings" }
      }
    },
    "ArtifactReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "diagnostics"],
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ArtifactRow" }
        },
        "diagnostics": { "$ref": "#/$defs/Strings" },
        "total": { "$ref": "common.schema.json#/$defs/safeNonNegativeInteger" }
      }
    },
    "ExportStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_ref",
        "artifact_type",
        "payload_type",
        "status",
        "missing_reason"
      ],
      "properties": {
        "paper_ref": { "$ref": "#/$defs/String" },
        "artifact_type": { "$ref": "#/$defs/String" },
        "payload_type": { "type": "string", "maxLength": 4096 },
        "status": { "$ref": "#/$defs/String" },
        "missing_reason": { "type": "string", "maxLength": 4096 }
      }
    },
    "ArtifactExportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_refs",
        "manifest_file",
        "artifact_statuses",
        "diagnostics"
      ],
      "properties": {
        "paper_refs": { "$ref": "#/$defs/Strings" },
        "paper_ref": { "$ref": "#/$defs/String" },
        "manifest_file": { "$ref": "#/$defs/String" },
        "artifact_statuses": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ExportStatus" }
        },
        "diagnostics": { "$ref": "#/$defs/Strings" },
        "delivery": {
          "$ref": "reverse-host.schema.json#/$defs/DeliveryProjection"
        }
      }
    },
    "Creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstName", "lastName", "creatorType"],
      "properties": {
        "firstName": { "type": "string", "maxLength": 4096 },
        "lastName": { "type": "string", "maxLength": 4096 },
        "creatorType": { "$ref": "#/$defs/String" }
      }
    },
    "LibraryPaper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_ref",
        "library_id",
        "item_key",
        "title",
        "year",
        "item_type",
        "creators",
        "tags",
        "collections"
      ],
      "properties": {
        "paper_ref": { "$ref": "#/$defs/String" },
        "library_id": { "type": "integer", "minimum": 1 },
        "item_key": { "$ref": "#/$defs/String" },
        "title": { "type": "string", "maxLength": 16384 },
        "year": { "type": "string", "maxLength": 128 },
        "item_type": { "$ref": "#/$defs/String" },
        "creators": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/Creator" }
        },
        "tags": { "$ref": "#/$defs/Strings" },
        "collections": { "$ref": "#/$defs/Strings" }
      }
    },
    "CountedTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "count"],
      "properties": {
        "tag": { "$ref": "#/$defs/String" },
        "count": { "$ref": "common.schema.json#/$defs/safeNonNegativeInteger" }
      }
    },
    "CountedCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "name", "library_id", "item_count"],
      "properties": {
        "id": { "$ref": "#/$defs/String" },
        "key": { "$ref": "#/$defs/String" },
        "name": { "$ref": "#/$defs/String" },
        "library_id": { "type": "integer", "minimum": 1 },
        "item_count": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "TopicRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "title", "status"],
      "properties": {
        "topic_id": { "$ref": "#/$defs/String" },
        "title": { "type": "string", "maxLength": 16384 },
        "status": { "$ref": "#/$defs/String" },
        "created_at": { "$ref": "#/$defs/String" },
        "updated_at": { "$ref": "#/$defs/String" },
        "current_artifact_path": { "$ref": "#/$defs/String" }
      }
    },
    "PageMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "nextCursor",
        "hasMore",
        "returned",
        "total",
        "limit"
      ],
      "properties": {
        "cursor": { "type": "string", "maxLength": 128 },
        "nextCursor": { "type": "string", "maxLength": 128 },
        "hasMore": { "type": "boolean" },
        "returned": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "total": { "$ref": "common.schema.json#/$defs/safeNonNegativeInteger" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "LibraryIndexRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "type": "string", "maxLength": 128 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "includeTags": { "type": "boolean" },
        "includeCollections": { "type": "boolean" },
        "includeItems": { "type": "boolean" }
      }
    },
    "LibraryIndexResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryId",
        "papers",
        "cursor",
        "next_cursor",
        "has_more",
        "returned",
        "total_papers",
        "limit",
        "index_hash",
        "pagination",
        "page_hash"
      ],
      "properties": {
        "libraryId": { "type": "integer", "minimum": 1 },
        "papers": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/LibraryPaper" }
        },
        "cursor": { "type": "string", "maxLength": 128 },
        "next_cursor": { "type": "string", "maxLength": 128 },
        "has_more": { "type": "boolean" },
        "returned": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "total_papers": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "index_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "page_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["papers"],
          "properties": { "papers": { "$ref": "#/$defs/PageMeta" } }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "cursor",
            "nextCursor",
            "hasMore",
            "returned",
            "total",
            "limit"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/CountedTag" }
            },
            "cursor": { "type": "string" },
            "nextCursor": { "type": "string" },
            "hasMore": { "type": "boolean" },
            "returned": { "type": "integer" },
            "total": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        },
        "collections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "cursor",
            "nextCursor",
            "hasMore",
            "returned",
            "total",
            "limit"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/CountedCollection" }
            },
            "cursor": { "type": "string" },
            "nextCursor": { "type": "string" },
            "hasMore": { "type": "boolean" },
            "returned": { "type": "integer" },
            "total": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        },
        "topics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "cursor",
            "nextCursor",
            "hasMore",
            "returned",
            "total",
            "limit"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/TopicRow" }
            },
            "cursor": { "type": "string" },
            "nextCursor": { "type": "string" },
            "hasMore": { "type": "boolean" },
            "returned": { "type": "integer" },
            "total": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "cursor",
            "nextCursor",
            "hasMore",
            "returned",
            "total",
            "limit"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/LibraryPaper" }
            },
            "cursor": { "type": "string" },
            "nextCursor": { "type": "string" },
            "hasMore": { "type": "boolean" },
            "returned": { "type": "integer" },
            "total": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    },
    "DebugCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cacheKey", "cacheKind", "status", "updatedAt"],
      "properties": {
        "cacheKey": { "$ref": "#/$defs/String" },
        "cacheKind": { "$ref": "#/$defs/String" },
        "status": { "$ref": "#/$defs/String" },
        "updatedAt": { "$ref": "#/$defs/String" }
      }
    },
    "DebugOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "operationType", "status", "updatedAt"],
      "properties": {
        "operationId": { "$ref": "#/$defs/String" },
        "operationType": { "$ref": "#/$defs/String" },
        "status": { "$ref": "#/$defs/String" },
        "updatedAt": { "$ref": "#/$defs/String" }
      }
    },
    "DebugTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topicId",
        "status",
        "manifestHash",
        "artifactHash",
        "metadataHash",
        "sectionCount",
        "diagnostics"
      ],
      "properties": {
        "topicId": { "$ref": "#/$defs/String" },
        "status": { "enum": ["absent", "ready", "invalid"] },
        "manifestHash": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "artifactHash": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "metadataHash": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "sectionCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "DebugCachePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "cursor",
        "nextCursor",
        "limit",
        "truncated",
        "diagnostics"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/DebugCache" }
        },
        "cursor": { "type": "string" },
        "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "limit": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "DebugOperationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "cursor",
        "nextCursor",
        "limit",
        "truncated",
        "diagnostics"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/DebugOperation" }
        },
        "cursor": { "type": "string" },
        "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "limit": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "DebugTopicPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "cursor",
        "nextCursor",
        "limit",
        "truncated",
        "diagnostics"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/DebugTopic" }
        },
        "cursor": { "type": "string" },
        "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "limit": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "Unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics"],
      "properties": {
        "status": { "const": "unavailable" },
        "diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "GetPaperArtifactManifestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/ArtifactFilter" }
        }
      }
    },
    "GetPaperArtifactManifestResult": { "$ref": "#/$defs/ArtifactReadResult" },
    "ExportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_refs"],
      "properties": {
        "paper_refs": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/String" }
        },
        "artifact_types": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/String" }
        },
        "run_root": { "$ref": "#/$defs/String" }
      }
    },
    "DeliveryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["local", "remote"] } }
    },
    "ExportFilteredPaperArtifactsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/$defs/ExportPayload" }
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/ExportPayload" },
                { "$ref": "#/$defs/DeliveryContext" }
              ],
              "items": false
            }
          ]
        }
      }
    },
    "ExportFilteredPaperArtifactsResult": {
      "$ref": "#/$defs/ArtifactExportResult"
    },
    "GetSchemasRequest": { "$ref": "#/$defs/OptionalEmptyRequest" },
    "GetSchemasResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schemas", "redaction"],
      "properties": {
        "schema": { "const": "synthesis-artifact-library-debug-schemas.v1" },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_bundle",
            "canonical_metadata",
            "artifact_manifest",
            "library_index",
            "debug_snapshot"
          ],
          "properties": {
            "result_bundle": {
              "const": "synthesis.topic_synthesis_result_bundle@1.0.0"
            },
            "canonical_metadata": {
              "const": "synthesis.topic_artifact_metadata@1.0.0"
            },
            "artifact_manifest": {
              "const": "synthesis.paper_artifact_manifest@1.0.0"
            },
            "library_index": { "const": "synthesis.library_index@1.0.0" },
            "debug_snapshot": { "const": "synthesis.debug-maintenance.v1" }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_paths", "credentials", "host_objects"],
          "properties": {
            "local_paths": { "const": "[redacted-path]" },
            "credentials": { "const": "omitted" },
            "host_objects": { "const": "omitted" }
          }
        }
      }
    },
    "GetLibraryIndexRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/LibraryIndexRequest" }
        }
      }
    },
    "GetLibraryIndexResult": { "$ref": "#/$defs/LibraryIndexResult" },
    "DebugSynthesisSnapshotRequest": { "$ref": "#/$defs/OptionalEmptyRequest" },
    "DebugSynthesisSnapshotResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "status", "diagnostics"],
      "properties": {
        "schemaId": { "const": "synthesis.debug-maintenance.v1" },
        "status": { "enum": ["ready", "superseded"] },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "revision"],
          "properties": {
            "schemaVersion": { "$ref": "#/$defs/String" },
            "revision": { "$ref": "#/$defs/String" }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "aggregateCount", "diagnostics"],
          "properties": {
            "schemaVersion": { "$ref": "#/$defs/String" },
            "aggregateCount": { "type": "integer" },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/Diagnostic" }
            }
          }
        },
        "caches": { "$ref": "#/$defs/DebugCachePage" },
        "operations": { "$ref": "#/$defs/DebugOperationPage" },
        "topics": { "$ref": "#/$defs/DebugTopicPage" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "DebugRowsPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "total",
        "truncated",
        "cursor",
        "next_cursor",
        "has_more",
        "limit"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/DebugOperation" }
        },
        "total": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "cursor": { "type": "string" },
        "next_cursor": { "type": "string" },
        "has_more": { "type": "boolean" },
        "limit": { "type": "integer" }
      }
    },
    "DebugCacheListPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cacheKind": { "$ref": "#/$defs/String" }
      }
    },
    "DebugSynthesisCacheListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/DebugCacheListPayload" }
        }
