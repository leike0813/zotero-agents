{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/client-concept-topic-graph.schema.json",
  "$defs": {
    "NoArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": { "args": { "type": "array", "maxItems": 0 } }
    },
    "String": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "Strings": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/String" }
    },
    "NullableHash": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "$ref": "#/$defs/String" },
        "severity": { "enum": ["warning", "error"] }
      }
    },
    "ConceptMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifestHash",
        "revision",
        "changedConceptIds",
        "reviewIds",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "committed",
            "unchanged",
            "not_found",
            "basis_mismatch",
            "concept_kb_busy",
            "invalid_request",
            "worker_failed",
            "stopping"
          ]
        },
        "manifestHash": { "$ref": "#/$defs/NullableHash" },
        "revision": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "changedConceptIds": { "$ref": "#/$defs/Strings" },
        "reviewIds": { "$ref": "#/$defs/Strings" },
        "diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "TopicGraphMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifestHash",
        "revision",
        "changedNodeIds",
        "changedEdgeIds",
        "reviewIds",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "committed",
            "unchanged",
            "not_found",
            "basis_mismatch",
            "topic_graph_busy",
            "invalid_request",
            "worker_failed",
            "stopping"
          ]
        },
        "manifestHash": { "$ref": "#/$defs/NullableHash" },
        "revision": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "changedNodeIds": { "$ref": "#/$defs/Strings" },
        "changedEdgeIds": { "$ref": "#/$defs/Strings" },
        "reviewIds": { "$ref": "#/$defs/Strings" },
        "diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "ConceptQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/String" }
        },
        "aliases": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/String" }
        },
        "label": { "$ref": "#/$defs/String" },
        "query": { "$ref": "#/$defs/String" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ConceptQueryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "labels",
        "matches",
        "truncated",
        "limits",
        "diagnostics"
      ],
      "properties": {
        "ok": { "const": true },
        "labels": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/String" }
        },
        "matches": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "worker.schema.json#/$defs/ConceptQueryMatch" }
        },
        "truncated": { "type": "boolean" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "maxLimit", "total"],
          "properties": {
            "limit": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            },
            "maxLimit": { "const": 100 },
            "total": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "$ref": "#/$defs/String" },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requested"],
                "properties": {
                  "requested": {
                    "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
                  }
                }
              }
            }
          }
        }
      }
    },
    "QueryConceptKbRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/ConceptQueryRequest" }
        }
      }
    },
    "QueryConceptKbResult": { "$ref": "#/$defs/ConceptQueryResult" },
    "RebuildTopicGraphIndexRequest": { "$ref": "#/$defs/NoArgs" },
    "RebuildTopicGraphIndexResult": {
      "$ref": "client-webdav-maintenance.schema.json#/$defs/MaintenanceOperation"
    },
    "TopicGraphEdgePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId"],
      "properties": { "edgeId": { "$ref": "#/$defs/String" } }
    },
    "AcceptTopicGraphRelationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/TopicGraphEdgePayload" }
        }
      }
    },
    "AcceptTopicGraphRelationResult": {
      "$ref": "#/$defs/TopicGraphMutationResult"
    },
    "RejectTopicGraphRelationRequest": {
      "$ref": "#/$defs/AcceptTopicGraphRelationRequest"
    },
    "RejectTopicGraphRelationResult": {
      "$ref": "#/$defs/TopicGraphMutationResult"
    },
    "TopicGraphReviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "action"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/String" },
        "action": { "enum": ["approve_suggested", "reject"] }
      }
    },
    "ApplyTopicGraphReviewActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/TopicGraphReviewPayload" }
        }
      }
    },
    "ApplyTopicGraphReviewActionResult": {
      "$ref": "#/$defs/TopicGraphMutationResult"
    },
    "RebuildConceptKbIndexRequest": { "$ref": "#/$defs/NoArgs" },
    "RebuildConceptKbIndexResult": {
      "$ref": "client-webdav-maintenance.schema.json#/$defs/MaintenanceOperation"
    },
    "ConceptDisplayPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "fields"],
      "properties": {
        "conceptId": { "$ref": "#/$defs/String" },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "short_definition": { "type": "string", "maxLength": 4096 },
            "definition": { "type": "string", "maxLength": 4096 },
            "usage_note": { "type": "string", "maxLength": 4096 },
            "editorial_note": { "type": "string", "maxLength": 4096 }
          }
        }
      }
    },
    "UpdateConceptDisplayTextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/ConceptDisplayPayload" }
        }
      }
    },
    "UpdateConceptDisplayTextResult": {
      "$ref": "#/$defs/ConceptMutationResult"
    },
    "ConceptReviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "action"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/String" },
        "action": {
          "enum": ["approve_create", "merge_into_existing", "reject"]
        },
        "targetConceptId": { "$ref": "#/$defs/String" }
      }
    },
    "ApplyConceptReviewActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/ConceptReviewPayload" }
        }
      }
    },
    "ApplyConceptReviewActionResult": {
      "$ref": "#/$defs/ConceptMutationResult"
    },
    "ConceptDeletePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptIds"],
      "properties": { "conceptIds": { "$ref": "#/$defs/Strings" } }
    },
    "DeleteConceptEntriesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/ConceptDeletePayload" }
        }
      }
    },
    "DeleteConceptEntriesResult": { "$ref": "#/$defs/ConceptMutationResult" }
  }
}
