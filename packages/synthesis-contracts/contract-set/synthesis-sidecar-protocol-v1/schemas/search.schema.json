{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/search.schema.json",
  "$defs": {
    "PortableItemRef": {
      "$ref": "reverse-host.schema.json#/$defs/EvidenceItemRef"
    },
    "SearchRequestCore": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "$comment": "Defaults are limit=25 and maxResults=100. UTF-16 bounds and effective paging relation are enforced by strict request rebuilders."
    },
    "SearchRequest": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/SearchRequestCore" }],
      "unevaluatedProperties": false
    },
    "EvidenceSearchRequest": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchRequestCore" },
        {
          "type": "object",
          "properties": {
            "libraryIds": {
              "$ref": "#/$defs/ResolvedLibraryIds"
            },
            "itemRefs": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/PortableItemRef" }
            },
            "collectionRef": { "$ref": "#/$defs/PortableItemRef" },
            "tag": { "type": "string", "minLength": 1, "maxLength": 256 },
            "itemType": { "type": "string", "minLength": 1, "maxLength": 64 },
            "sourceKinds": {
              "type": "array",
              "maxItems": 3,
              "items": { "$ref": "#/$defs/SourceKind" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LibraryLexicalExecutionRequest": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/EvidenceSearchRequest" },
        {
          "type": "object",
          "required": ["libraryIds"],
          "properties": {
            "libraryIds": { "$ref": "#/$defs/ResolvedLibraryIds" },
            "cursor": false
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ResolvedLibraryIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "EvidenceRequest": { "$ref": "#/$defs/EvidenceSearchRequest" },
    "TopicRequest": { "$ref": "#/$defs/TopicSearchRequest" },
    "SearchEvidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/EvidenceSearchRequest" }
        }
      }
    },
    "SearchEvidenceResult": { "$ref": "#/$defs/EvidenceSearchResult" },
    "TopicSearchRequest": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchRequestCore" },
        {
          "type": "object",
          "properties": {
            "sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "topic-domain.schema.json#/$defs/TopicSectionName"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SourceKind": {
      "$ref": "reverse-host.schema.json#/$defs/EvidenceSourceKind"
    },
    "LibrarySearchCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sources"],
      "properties": {
        "kind": { "const": "library" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata", "fulltext", "analysis"],
          "properties": {
            "metadata": { "$ref": "#/$defs/SourceCoverage" },
            "fulltext": { "$ref": "#/$defs/SourceCoverage" },
            "analysis": { "$ref": "#/$defs/SourceCoverage" }
          }
        }
      }
    },
    "WorkStatus": {
      "enum": ["complete", "not_requested", "limited", "unavailable"]
    },
    "SearchMethod": {
      "enum": ["lexical", "vector", "hybrid"]
    },
    "SearchCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sources"],
          "properties": {
            "kind": { "const": "library" },
            "sources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metadata", "fulltext", "analysis"],
              "properties": {
                "metadata": { "$ref": "#/$defs/SourceCoverage" },
                "fulltext": { "$ref": "#/$defs/SourceCoverage" },
                "analysis": { "$ref": "#/$defs/SourceCoverage" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sections"],
          "properties": {
            "kind": { "const": "topic" },
            "sections": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/SectionCoverage" }
            }
          }
        }
      ]
    },
    "SourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourcesScanned"],
      "properties": {
        "status": { "$ref": "#/$defs/WorkStatus" },
        "sourcesScanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "SectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "status"],
      "properties": {
        "section": {
          "$ref": "topic-domain.schema.json#/$defs/TopicSectionName"
        },
        "status": { "$ref": "#/$defs/WorkStatus" }
      }
    },
    "SearchIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "sourceKind", "affectedCount"],
      "properties": {
        "code": {
          "enum": [
            "source_unavailable",
            "source_changed",
            "source_read_failed",
            "invalid_source",
            "scan_budget_exhausted",
            "passage_budget_exhausted",
            "result_budget_exhausted",
            "vector_unavailable"
          ]
        },
        "sourceKind": {
          "oneOf": [{ "$ref": "#/$defs/SourceKind" }, { "type": "null" }]
        },
        "affectedCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "EvidenceSource": {
      "$ref": "reverse-host.schema.json#/$defs/EvidenceSource"
    },
    "EvidenceLocation": {
      "$ref": "reverse-host.schema.json#/$defs/EvidenceLocation"
    },
    "EvidenceCore": {
      "type": "object",
      "required": ["content", "format", "source", "sourceVersion", "location"],
      "properties": {
        "content": { "type": "string", "maxLength": 8192 },
        "format": { "enum": ["text", "markdown"] },
        "source": { "$ref": "#/$defs/EvidenceSource" },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "location": { "$ref": "#/$defs/EvidenceLocation" }
      },
      "$comment": "Strict TypeScript and Rust rebuilders additionally enforce UTF-16 lengths, exact range/content lengths, source/location field equality, and matching library identity."
    },
    "EvidenceContext": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/EvidenceCore" }],
      "unevaluatedProperties": false
    },
    "EvidencePassage": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/EvidenceCore" },
        {
          "type": "object",
          "required": ["itemRef", "context"],
          "properties": {
            "itemRef": { "$ref": "#/$defs/PortableItemRef" },
            "context": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/EvidenceContext" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TopicMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "matchedSections", "matchReasons"],
      "properties": {
        "topicId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "matchedSections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "topic-domain.schema.json#/$defs/TopicSectionName"
          }
        },
        "matchReasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["query_terms", "exact_phrase", "semantic"] }
        }
      }
    },
    "EvidenceSearchResult": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchResultBase" },
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidencePassage" }
            },
            "coverage": { "$ref": "#/$defs/LibrarySearchCoverage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LibraryLexicalItemMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceVersion",
        "location",
        "matchedTerms",
        "phraseMatch"
      ],
      "properties": {
        "source": { "$ref": "reverse-host.schema.json#/$defs/EvidenceSource" },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "location": {
          "$ref": "reverse-host.schema.json#/$defs/EvidenceLocation"
        },
        "matchedTerms": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "phraseMatch": { "type": "boolean" }
      }
    },
    "LibraryLexicalItemResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "matches"],
      "properties": {
        "itemRef": { "$ref": "#/$defs/PortableItemRef" },
        "matches": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/LibraryLexicalItemMatch" }
        }
      }
    },
    "LibraryLexicalSearchResult": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchResultBase" },
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 500,
              "items": { "$ref": "#/$defs/LibraryLexicalItemResult" }
            },
            "coverage": { "$ref": "#/$defs/LibrarySearchCoverage" },
            "method": { "const": "lexical" },
            "nextCursor": { "const": null },
            "hasMore": { "const": false }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LibraryRetrievalSearchResult": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchResultBase" },
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 500,
              "items": { "$ref": "#/$defs/LibraryLexicalItemResult" }
            },
            "coverage": { "$ref": "#/$defs/LibrarySearchCoverage" },
            "method": { "$ref": "#/$defs/SearchMethod" },
            "nextCursor": { "const": null },
            "hasMore": { "const": false }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LibraryRetrievalExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "scope",
        "descriptors",
        "catalogIssues",
        "catalogLimited",
        "publication"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/LibraryRetrievalSearchResult" },
        "scope": {
          "$ref": "reverse-host.schema.json#/$defs/ResolvedEvidenceScope"
        },
        "descriptors": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "reverse-host.schema.json#/$defs/EvidenceDescriptor"
          }
        },
        "catalogIssues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/SearchIssue" }
        },
        "catalogLimited": { "type": "boolean" },
        "publication": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "LibraryLexicalExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "scope",
        "descriptors",
        "catalogIssues",
        "catalogLimited"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/LibraryLexicalSearchResult" },
        "scope": {
          "$ref": "reverse-host.schema.json#/$defs/ResolvedEvidenceScope"
        },
        "descriptors": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "reverse-host.schema.json#/$defs/EvidenceDescriptor"
          }
        },
        "catalogIssues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/SearchIssue" }
        },
        "catalogLimited": { "type": "boolean" }
      }
    },
    "EvidenceResult": { "$ref": "#/$defs/EvidenceSearchResult" },
    "TopicSearchResult": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/SearchResultBase" },
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/TopicMatch" }
            },
            "method": { "$ref": "#/$defs/SearchMethod" },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sections"],
              "properties": {
                "kind": { "const": "topic" },
                "sections": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "$ref": "#/$defs/SectionCoverage" }
                }
              }
            },
            "issues": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/SearchIssue" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "code": { "$ref": "#/$defs/SearchIssue/properties/code" },
                      "sourceKind": { "const": null },
                      "affectedCount": {
                        "$ref": "#/$defs/SearchIssue/properties/affectedCount"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TopicResult": { "$ref": "#/$defs/TopicSearchResult" },
    "SearchResultBase": {
      "type": "object",
      "required": [
        "results",
        "status",
        "method",
        "coverage",
        "issues",
        "nextCursor",
        "hasMore",
        "total"
      ],
      "properties": {
        "results": { "type": "array", "maxItems": 100, "items": {} },
        "status": { "enum": ["completed", "limited", "unavailable"] },
        "method": { "enum": ["lexical", "vector", "hybrid"] },
        "coverage": { "$ref": "#/$defs/SearchCoverage" },
        "issues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/SearchIssue" }
        },
        "nextCursor": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            { "type": "null" }
          ]
        },
        "hasMore": { "type": "boolean" },
        "total": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 1000000 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
