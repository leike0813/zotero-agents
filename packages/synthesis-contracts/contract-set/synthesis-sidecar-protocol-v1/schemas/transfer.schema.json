{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/transfer.schema.json",
  "$defs": {
    "StringArray": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceIds"],
      "properties": {
        "kind": { "enum": ["full", "source_slice"] },
        "sourceIds": {
          "type": "array",
          "maxItems": 25000,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        }
      }
    },
    "PageKind": {
      "enum": [
        "library_nodes",
        "references",
        "nodes",
        "resolved_edges",
        "aggregate_edges",
        "source_ownership",
        "incoming_groups",
        "light_metrics",
        "content"
      ]
    },
    "PageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pageIndex", "rowCount", "byteLength", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/PageKind" },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 255 },
        "rowCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "CitationInputPageDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "library_nodes" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "references" } }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "CitationOutputPageDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            { "type": "object", "properties": { "kind": { "const": "nodes" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "resolved_edges" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "aggregate_edges" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "source_ownership" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "incoming_groups" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": { "kind": { "const": "light_metrics" } }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "ContentPageDescriptor": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/PageDescriptor" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "content" },
            "rowCount": { "const": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LibraryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "authors", "aliases"],
      "properties": {
        "nodeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "title": { "type": "string", "maxLength": 4096 },
        "year": { "type": "string", "maxLength": 64 },
        "authors": { "$ref": "#/$defs/StringArray" },
        "aliases": { "$ref": "#/$defs/StringArray" }
      }
    },
    "ReferenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "edgeId",
        "sourceId",
        "targetId",
        "targetKind",
        "targetAuthors",
        "targetAliases",
        "roles",
        "weight"
      ],
      "properties": {
        "referenceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "edgeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "sourceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "sourceRef": { "type": "string", "maxLength": 4096 },
        "targetId": { "$ref": "common.schema.json#/$defs/identifier" },
        "targetKind": {
          "enum": [
            "library_paper",
            "external_reference",
            "unresolved_reference"
          ]
        },
        "targetTitle": { "type": "string", "maxLength": 4096 },
        "targetYear": { "type": "string", "maxLength": 64 },
        "targetAuthors": { "$ref": "#/$defs/StringArray" },
        "targetAliases": { "$ref": "#/$defs/StringArray" },
        "roles": { "$ref": "#/$defs/StringArray" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "GraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "authors", "aliases"],
      "properties": {
        "nodeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": {
          "enum": [
            "library_paper",
            "external_reference",
            "unresolved_reference"
          ]
        },
        "title": { "type": "string", "maxLength": 4096 },
        "year": { "type": "string", "maxLength": 64 },
        "authors": { "$ref": "#/$defs/StringArray" },
        "aliases": { "$ref": "#/$defs/StringArray" }
      }
    },
    "ResolvedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "referenceId",
        "sourceId",
        "targetId",
        "status",
        "roles",
        "weight"
      ],
      "properties": {
        "edgeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "referenceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "sourceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "targetId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "enum": ["accepted", "unbound"] },
        "roles": { "$ref": "#/$defs/StringArray" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "RoleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": { "$ref": "common.schema.json#/$defs/identifier" },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "AggregateEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "targetId",
        "mentionCount",
        "primaryRole",
        "auxRoles",
        "roleEvidence",
        "sourceRefs"
      ],
      "properties": {
        "sourceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "targetId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mentionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "primaryRole": { "$ref": "common.schema.json#/$defs/identifier" },
        "auxRoles": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/RoleEvidence" }
        },
        "roleEvidence": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/RoleEvidence" }
        },
        "sourceRefs": { "$ref": "#/$defs/StringArray" }
      }
    },
    "Ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "edgeId", "referenceId", "targetId", "status"],
      "properties": {
        "sourceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "edgeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "referenceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "targetId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "enum": ["accepted", "unbound"] }
      }
    },
    "LightMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "outgoingCount",
        "incomingCount",
        "localDegree",
        "matchedOutgoingCount",
        "unresolvedOutgoingCount",
        "ambiguousOutgoingCount"
      ],
      "properties": {
        "nodeId": { "$ref": "common.schema.json#/$defs/identifier" },
        "outgoingCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "incomingCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "localDegree": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "matchedOutgoingCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "unresolvedOutgoingCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "ambiguousOutgoingCount": { "const": 0 }
      }
    },
    "GraphDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCounts", "referenceCount", "aggregateEdgeCount"],
      "properties": {
        "nodeCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "library_paper",
            "external_reference",
            "unresolved_reference"
          ],
          "properties": {
            "library_paper": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            },
            "external_reference": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            },
            "unresolved_reference": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            }
          }
        },
        "referenceCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "aggregateEdgeCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "CitationInputHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "scope", "rolePriority"],
      "properties": {
        "contractVersion": { "const": "synthesis-citation-graph-build.v1" },
        "scope": { "$ref": "#/$defs/Scope" },
        "rolePriority": { "$ref": "#/$defs/StringArray" }
      }
    },
    "CitationOutputHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "scope", "diagnostics"],
      "properties": {
        "contractVersion": { "const": "synthesis-citation-graph-build.v1" },
        "scope": { "$ref": "#/$defs/Scope" },
        "diagnostics": { "$ref": "#/$defs/GraphDiagnostics" }
      }
    },
    "AssetDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mediaType",
        "byteLength",
        "sha256",
        "firstPage",
        "pageCount"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "mediaType": {
          "enum": ["application/json", "text/markdown", "text/plain"]
        },
        "byteLength": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "firstPage": { "type": "integer", "minimum": 0, "maximum": 255 },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "TopicAssetsHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "assets"],
      "properties": {
        "target": { "const": "topic_apply_assets" },
        "assets": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/AssetDescriptor" }
        }
      }
    },
    "ContentInputHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "enum": ["production_client_result", "host_export_entries"]
        }
      }
    },
    "ProductionClientCapability": {
      "enum": [
        "client.listTopics",
        "client.findTopicsByPaperRef",
        "client.getTopicContext",
        "client.resolveResolver",
        "client.queryCitationGraphCluster",
        "client.queryCitationGraph",
        "client.getCitationGraphSlice",
        "client.getCitationGraphLayout",
        "client.getCitationGraphMetrics",
        "client.rankLibraryPapers",
        "client.refreshCitationGraphMetricsNow",
        "client.startCitationGraphUpdate",
        "client.getReferenceSidecarIndex",
        "client.rankExternalReferences",
        "client.getAttentionQueue",
        "client.startReferenceSidecarRefresh",
        "client.getPaperArtifactManifest",
        "client.exportFilteredPaperArtifacts",
        "client.queryConceptKb",
        "client.getSchemas",
        "client.getPublicMaintenanceOperation",
        "client.controlPublicMaintenanceOperation",
        "client.getLibraryIndex",
        "client.getReviewInput",
        "client.debugSynthesisSnapshot",
        "client.debugSynthesisCacheList",
        "client.debugSynthesisOperationsList",
        "client.debugSynthesisProfilerList",
        "client.debugSynthesisPaperInspect",
        "client.debugSynthesisTopicInspect",
        "client.debugSynthesisDiff",
        "client.debugSynthesisCleanInstallReset",
        "client.listWorkflowTopicOptions",
        "client.getTopicPlanningContext",
        "client.applyTopicPlan",
        "client.reconcileSynthesisRuntimeWorkStateOnStartup",
        "client.resetSynthesisDatabase",
        "client.consumeRelatedItemsSyncEcho",
        "client.applyLiteratureDigestSidecar",
        "client.applyTopicSynthesisResult",
        "client.getTopicReport",
        "client.deleteTopicArtifact",
        "client.purgeDeletedTopicArtifacts",
        "client.rejectTopicDiscoveryHint",
        "client.restoreTopicDiscoveryHint",
        "client.rebuildTopicGraphIndex",
        "client.acceptTopicGraphRelation",
        "client.rejectTopicGraphRelation",
        "client.applyTopicGraphReviewAction",
        "client.readPaperArtifacts",
        "client.initializeBuiltinTagPolicy",
        "client.isBuiltinTagPolicyInitialized",
        "client.loadTagVocabulary",
        "client.saveTagVocabulary",
        "client.validateTagVocabulary",
        "client.rebuildTagVocabularyIndex",
        "client.exportTagVocabularyForRegulator",
        "client.listStagedTagSuggestions",
        "client.stageTagSuggestions",
        "client.updateStagedTagSuggestion",
        "client.updateTagVocabularyEntry",
        "client.deleteTagVocabularyEntry",
        "client.promoteStagedTagSuggestions",
        "client.discardStagedTagSuggestions",
        "client.clearStagedTagSuggestions",
        "client.previewTagVocabularyImport",
        "client.applyTagVocabularyImport",
        "client.replaceTagAuditRecords",
        "client.clearTagAuditRecord",
        "client.getSynthesisWorkbenchChromeInput",
        "client.getSynthesisWorkbenchSurfaceInput",
        "client.getSynthesisBackgroundJobRows",
        "client.readTopicDetail",
        "client.resolveTopicPaperDigest",
        "client.recomputeCitationGraphLayout",
        "client.rebuildCitationGraphCacheNow",
        "client.refreshCitationGraphCacheIncrementalNow",
        "client.retryCitationGraphCacheRebuild",
        "client.refreshReferenceSidecarNow",
        "client.retryReferenceSidecarRefresh",
        "client.runAdvancedReferenceMatchingNow",
        "client.retryAdvancedReferenceMatching",
        "client.applyCanonicalRevisionReviewAction",
        "client.applyReferenceMatchProposalAction",
        "client.applyReferenceMatchProposalActions",
        "client.mergeEffectiveCanonicalReference",
        "client.applyCanonicalRevisionMergeRequests",
        "client.updateCanonicalReferenceMetadata",
        "client.archiveCanonicalReference",
        "client.rebuildConceptKbIndex",
        "client.updateConceptDisplayText",
        "client.applyConceptReviewAction",
        "client.deleteConceptEntries",
        "client.syncWebDavNow",
        "client.pauseWebDavSync",
        "client.resumeWebDavSync",
        "client.retryWebDavSync",
        "client.resolveWebDavSyncConflict"
      ]
    },
    "ContentOutputHeader": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "capability", "byteLength", "sha256"],
          "properties": {
            "target": { "const": "production_client_result" },
            "capability": { "$ref": "#/$defs/ProductionClientCapability" },
            "byteLength": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            },
            "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "capability", "byteLength", "sha256"],
          "properties": {
            "target": { "const": "host_export_entries" },
            "capability": { "const": "paper_artifacts.export_filtered" },
            "byteLength": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            },
            "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
          }
        }
      ]
    },
    "CitationInputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferVersion",
        "encoding",
        "direction",
        "header",
        "pages",
        "rootSha256"
      ],
      "properties": {
        "transferVersion": {
          "const": "synthesis-citation-graph-build-transfer.v1"
        },
        "encoding": { "const": "canonical_json_rows.v1" },
        "direction": { "const": "input" },
        "header": { "$ref": "#/$defs/CitationInputHeader" },
        "pages": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/CitationInputPageDescriptor" }
        },
        "rootSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "CitationOutputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferVersion",
        "encoding",
        "direction",
        "header",
        "pages",
        "rootSha256"
      ],
      "properties": {
        "transferVersion": {
          "const": "synthesis-citation-graph-build-transfer.v1"
        },
        "encoding": { "const": "canonical_json_rows.v1" },
        "direction": { "const": "output" },
        "header": { "$ref": "#/$defs/CitationOutputHeader" },
        "pages": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/CitationOutputPageDescriptor" }
        },
        "rootSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "TopicAssetsManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferVersion",
        "encoding",
        "direction",
        "header",
        "pages",
        "rootSha256"
      ],
      "properties": {
        "transferVersion": {
          "const": "synthesis-production-content-transfer.v1"
        },
        "encoding": { "const": "canonical_json_text_chunks.v1" },
        "direction": { "const": "input" },
        "header": { "$ref": "#/$defs/TopicAssetsHeader" },
        "pages": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ContentPageDescriptor" }
        },
        "rootSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "ContentInputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferVersion",
        "encoding",
        "direction",
        "header",
        "pages",
        "rootSha256"
      ],
      "properties": {
        "transferVersion": {
          "const": "synthesis-production-content-transfer.v1"
        },
        "encoding": { "const": "canonical_json_text_chunks.v1" },
        "direction": { "const": "input" },
        "header": { "$ref": "#/$defs/ContentInputHeader" },
        "pages": { "type": "array", "maxItems": 0 },
        "rootSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "ContentOutputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferVersion",
        "encoding",
        "direction",
        "header",
        "pages",
        "rootSha256"
      ],
      "properties": {
        "transferVersion": {
          "const": "synthesis-production-content-transfer.v1"
        },
        "encoding": { "const": "canonical_json_text_chunks.v1" },
        "direction": { "const": "output" },
        "header": { "$ref": "#/$defs/ContentOutputHeader" },
        "pages": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ContentPageDescriptor" }
        },
        "rootSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "CitationInputPage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "library_nodes" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 25000,
              "items": { "$ref": "#/$defs/LibraryNode" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "references" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/ReferenceRow" }
            }
          }
        }
      ]
    },
    "CitationOutputPage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "nodes" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/GraphNode" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "resolved_edges" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/ResolvedEdge" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "aggregate_edges" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/AggregateEdge" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "source_ownership" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/Ownership" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "incoming_groups" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/Ownership" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "rows"],
          "properties": {
            "descriptor": {
              "type": "object",
              "allOf": [
                { "$ref": "#/$defs/PageDescriptor" },
                {
                  "type": "object",
                  "properties": { "kind": { "const": "light_metrics" } }
                }
              ],
              "unevaluatedProperties": false
            },
            "rows": {
              "type": "array",
              "maxItems": 100000,
              "items": { "$ref": "#/$defs/LightMetric" }
            }
          }
        }
      ]
    },
    "ContentPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "rows"],
      "properties": {
        "descriptor": {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/PageDescriptor" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "content" },
                "rowCount": { "const": 1 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/canonicalTextChunk" }
        }
      }
    },
    "BeginAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idempotencyKey", "manifest"],
      "properties": {
        "action": { "const": "begin" },
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/identifier" },
        "manifest": {
          "oneOf": [
            { "$ref": "#/$defs/CitationInputManifest" },
            { "$ref": "#/$defs/TopicAssetsManifest" },
            { "$ref": "#/$defs/ContentInputManifest" }
          ]
        }
      }
    },
    "PutInputPageAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sessionId", "page"],
      "properties": {
        "action": { "const": "put_input_page" },
        "sessionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "page": {
          "oneOf": [
            { "$ref": "#/$defs/CitationInputPage" },
            { "$ref": "#/$defs/ContentPage" }
          ]
        }
      }
    },
    "SessionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sessionId"],
      "properties": {
        "action": {
          "enum": [
            "seal_input",
            "execute",
            "status",
            "get_output_manifest",
            "cancel"
          ]
        },
        "sessionId": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    },
    "GetOutputPageAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sessionId", "kind", "pageIndex"],
      "properties": {
        "action": { "const": "get_output_page" },
        "sessionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/PageKind" },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "TransferContentRequest": {
      "oneOf": [
        { "$ref": "#/$defs/BeginAction" },
        { "$ref": "#/$defs/PutInputPageAction" },
        { "$ref": "#/$defs/SessionAction" },
        { "$ref": "#/$defs/GetOutputPageAction" }
      ]
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receivedPages", "totalPages", "stagedBytes"],
      "properties": {
        "receivedPages": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "totalPages": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "stagedBytes": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts"],
      "properties": {
        "attempts": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "lastFailure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable", "atMs"],
          "properties": {
            "code": {
              "enum": [
                "worker_timeout",
                "worker_canceled",
                "worker_crashed",
                "worker_result_invalid",
                "worker_unavailable",
                "transfer_limit_exceeded",
                "transfer_conflict",
                "internal_error"
              ]
            },
            "retryable": { "type": "boolean" },
            "atMs": {
              "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
            }
          }
        }
      }
    },
    "StatusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "state",
        "input",
        "execution",
        "stagedBytes",
        "createdAtMs",
        "lastActivityAtMs"
      ],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "state": {
          "enum": [
            "receiving_input",
            "input_sealed",
            "queued",
            "executing",
            "publishing_output",
            "completed"
          ]
        },
        "input": { "$ref": "#/$defs/Progress" },
        "output": { "$ref": "#/$defs/Progress" },
        "execution": { "$ref": "#/$defs/Execution" },
        "stagedBytes": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "createdAtMs": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "lastActivityAtMs": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "CanceledResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canceled"],
      "properties": { "canceled": { "const": true } }
    },
    "TransferContentResult": {
      "oneOf": [
        { "$ref": "#/$defs/StatusResult" },
        { "$ref": "#/$defs/CitationOutputManifest" },
        { "$ref": "#/$defs/ContentOutputManifest" },
        { "$ref": "#/$defs/CitationOutputPage" },
        { "$ref": "#/$defs/ContentPage" },
        { "$ref": "#/$defs/CanceledResult" }
      ]
    }
  }
}
