{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/topic-domain.schema.json",
  "$defs": {
    "String": { "type": "string", "maxLength": 65536 },
    "NonEmptyString": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "Strings": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/String" } },
    "NonEmptyStrings": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/NonEmptyString" } },
    "StringMap": { "type": "object", "maxProperties": 256, "patternProperties": { "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$": { "$ref": "#/$defs/String" } }, "additionalProperties": false },
    "HashMap": { "type": "object", "maxProperties": 256, "patternProperties": { "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$": { "type": "string", "minLength": 1, "maxLength": 80 } }, "additionalProperties": false },
    "TopicDefinition": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/NonEmptyString" }, "title": { "$ref": "#/$defs/NonEmptyString" }, "name": { "$ref": "#/$defs/NonEmptyString" }, "definition": { "$ref": "#/$defs/String" }, "aliases": { "$ref": "#/$defs/Strings" }, "scope_include": { "$ref": "#/$defs/Strings" }, "scope_exclude": { "$ref": "#/$defs/Strings" } }
    },
    "ResolverTag": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "and": { "$ref": "#/$defs/NonEmptyStrings" }, "or": { "$ref": "#/$defs/NonEmptyStrings" }, "not": { "$ref": "#/$defs/NonEmptyStrings" } }
    },
    "TopicResolver": {
      "type": "object", "additionalProperties": false, "required": ["paper_refs", "collection_key", "combine"],
      "properties": { "paper_refs": { "$ref": "#/$defs/NonEmptyStrings" }, "collection_key": { "$ref": "#/$defs/NonEmptyStrings" }, "tag": { "$ref": "#/$defs/ResolverTag" }, "combine": { "enum": ["union", "intersection"] } }
    },
    "DigestReference": {
      "type": "object", "additionalProperties": false, "required": ["paper_ref", "payload_type"],
      "properties": { "paper_ref": { "$ref": "#/$defs/NonEmptyString" }, "payload_type": { "const": "digest-markdown" }, "note_key": { "$ref": "#/$defs/NonEmptyString" }, "path": { "$ref": "#/$defs/NonEmptyString" }, "locator": { "$ref": "#/$defs/NonEmptyString" }, "payload_hash": { "type": "string", "minLength": 1, "maxLength": 80 }, "library_id": { "type": "integer", "minimum": 1 } }
    },
    "ResolvedPaper": {
      "type": "object", "additionalProperties": false, "required": ["paper_ref"],
      "properties": { "paper_ref": { "$ref": "#/$defs/NonEmptyString" }, "item_key": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "year": { "$ref": "#/$defs/String" }, "summary": { "$ref": "#/$defs/String" }, "synthesis_role": { "$ref": "#/$defs/String" }, "match_reasons": { "$ref": "#/$defs/Strings" }, "authors": { "$ref": "#/$defs/Strings" }, "role": { "$ref": "#/$defs/String" }, "literature_quality": { "$ref": "#/$defs/LiteratureQuality" }, "context_selection_score": { "type": "number" }, "caveats": { "$ref": "#/$defs/Strings" }, "digest_ref": { "$ref": "#/$defs/DigestReference" } }
    },
    "LiteratureQuality": {
      "type": "object", "additionalProperties": false,
      "properties": { "level": { "$ref": "#/$defs/String" }, "score": { "type": "number" }, "reason": { "$ref": "#/$defs/String" }, "dimensions": { "$ref": "#/$defs/StringMap" } }
    },
    "ResolvedPaperSet": {
      "type": "object", "additionalProperties": false, "required": ["papers"],
      "properties": { "papers": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ResolvedPaper" } } }
    },
    "ConceptCard": {
      "type": "object", "additionalProperties": false, "required": ["label", "aliases", "concept_type", "definition", "topic_relevance"],
      "properties": { "label": { "$ref": "#/$defs/NonEmptyString" }, "aliases": { "$ref": "#/$defs/Strings" }, "concept_type": { "$ref": "#/$defs/NonEmptyString" }, "domain": { "$ref": "#/$defs/String" }, "short_definition": { "$ref": "#/$defs/String" }, "definition": { "$ref": "#/$defs/String" }, "disambiguation": { "$ref": "#/$defs/String" }, "topic_relevance": { "$ref": "#/$defs/String" }, "confidence": { "$ref": "#/$defs/ConceptConfidence" }, "evidence": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ConceptEvidence" } }, "relations": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ConceptRelation" } } }
    },
    "ConceptConfidence": { "enum": ["high", "medium", "low"] },
    "ConceptEvidence": {
      "type": "object", "additionalProperties": false, "required": ["paper_ref"],
      "properties": { "paper_ref": { "$ref": "#/$defs/NonEmptyString" }, "quote_or_summary": { "$ref": "#/$defs/String" }, "section": { "$ref": "#/$defs/String" } }
    },
    "ConceptRelation": {
      "type": "object", "additionalProperties": false, "required": ["target_concept_id", "relation", "confidence"],
      "properties": { "target_concept_id": { "$ref": "#/$defs/NonEmptyString" }, "relation": { "$ref": "#/$defs/NonEmptyString" }, "confidence": { "$ref": "#/$defs/ConceptConfidence" }, "provenance": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ConceptEvidence" } } }
    },
    "TopicRelationType": { "enum": ["target_is_broader_topic_candidate", "target_is_narrower_topic_candidate", "related_topic_candidate", "overlap_topic_candidate", "contrast_topic_candidate"] },
    "ExistingTopicRelationProposal": {
      "type": "object", "additionalProperties": false, "required": ["target_topic_id", "relation_type", "confidence", "rationale", "source_paper_refs"],
      "properties": { "target_topic_id": { "$ref": "#/$defs/NonEmptyString" }, "target_topic_title": { "$ref": "#/$defs/String" }, "relation_type": { "$ref": "#/$defs/TopicRelationType" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "rationale": { "$ref": "#/$defs/NonEmptyString" }, "source_paper_refs": { "$ref": "#/$defs/NonEmptyStrings" } }
    },
    "ConceptCardsProposal": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_id": { "const": "synthesis.concept_cards_proposal" }, "schema_version": { "const": "1.0.0" }, "cards": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ConceptCard" } } }
    },
    "TopicRelationProposals": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_id": { "const": "synthesis.topic_graph_relation_proposals" }, "schema_version": { "const": "1.0.0" }, "proposals": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ExistingTopicRelationProposal" } } }
    },
    "TopicInterestMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema": { "const": "topic_interest_metadata.v1" }, "topic_id": { "$ref": "#/$defs/NonEmptyString" }, "include_terms": { "$ref": "#/$defs/NonEmptyStrings" }, "must_have_terms": { "$ref": "#/$defs/NonEmptyStrings" }, "methods": { "$ref": "#/$defs/NonEmptyStrings" }, "exclude_terms": { "$ref": "#/$defs/NonEmptyStrings" }, "seed_literature_item_ids": { "$ref": "#/$defs/NonEmptyStrings" } }
    },
    "TopicGraphProjection": {
      "type": "object", "additionalProperties": false, "required": ["topic", "relations"],
      "properties": { "topic": { "type": "object", "additionalProperties": false, "required": ["topic_id", "title", "definition", "artifact_hash"], "properties": { "topic_id": { "$ref": "#/$defs/NonEmptyString" }, "title": { "$ref": "#/$defs/String" }, "definition": { "$ref": "#/$defs/String" }, "artifact_hash": { "type": "string", "minLength": 1, "maxLength": 80 } } }, "relations": { "$ref": "#/$defs/TopicRelationProposals" } }
    },
    "TopicDependencyArtifact": {
      "type": "object", "additionalProperties": false, "required": ["status", "hash"],
      "properties": { "status": { "$ref": "#/$defs/String" }, "hash": { "$ref": "#/$defs/String" } }
    },
    "TopicDependencyArtifactMap": {
      "type": "object", "maxProperties": 8, "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,63}$": { "$ref": "#/$defs/TopicDependencyArtifact" } }, "additionalProperties": false
    },
    "TopicDependencySnapshot": {
      "type": "object", "additionalProperties": false, "required": ["paper_refs", "paper_artifacts", "missing_artifacts"],
      "properties": { "paper_refs": { "$ref": "#/$defs/NonEmptyStrings" }, "paper_artifacts": { "type": "object", "maxProperties": 25000, "patternProperties": { "^.{1,512}$": { "$ref": "#/$defs/TopicDependencyArtifactMap" } }, "additionalProperties": false }, "missing_artifacts": { "$ref": "#/$defs/Strings" } }
    },
    "TopicReadinessProjection": {
      "type": "object", "additionalProperties": false, "required": ["baseline_input_hash", "baseline_dependencies", "current_input_hash", "current_dependencies", "baseline_initialized_at", "last_scanned_at"],
      "properties": { "baseline_input_hash": { "$ref": "#/$defs/String" }, "baseline_dependencies": { "anyOf": [{ "$ref": "#/$defs/TopicDependencySnapshot" }, { "type": "null" }] }, "current_input_hash": { "$ref": "#/$defs/String" }, "current_dependencies": { "anyOf": [{ "$ref": "#/$defs/TopicDependencySnapshot" }, { "type": "null" }] }, "baseline_initialized_at": { "$ref": "#/$defs/String" }, "last_scanned_at": { "$ref": "#/$defs/String" } }
    },
    "TopicProjection": {
      "type": "object", "additionalProperties": false, "required": ["freshness", "source_materials_status", "source_materials_percent", "stale_reasons", "dirty_reasons", "missing_sections"],
      "properties": { "topicGraph": { "$ref": "#/$defs/TopicGraphProjection" }, "concepts": { "$ref": "#/$defs/ConceptCardsProposal" }, "interestMetadata": { "$ref": "#/$defs/TopicInterestMetadata" }, "discovery": { "type": "object", "additionalProperties": false, "required": ["source_paper_refs"], "properties": { "source_paper_refs": { "$ref": "#/$defs/NonEmptyStrings" }, "readiness": { "$ref": "#/$defs/TopicReadinessProjection" } } }, "recommendedUpdate": { "type": "object", "additionalProperties": false, "required": ["actionLabel", "freshness", "sourceMaterialsStatus"], "properties": { "actionLabel": { "const": "Update" }, "freshness": { "enum": ["fresh", "stale", "dirty", "queued", "running", "failed", "unknown"] }, "sourceMaterialsStatus": { "enum": ["complete", "partial", "missing"] }, "blocked": { "type": "boolean" } } }, "freshness": { "enum": ["fresh", "stale", "dirty", "queued", "running", "failed", "unknown"] }, "source_materials_status": { "enum": ["complete", "partial", "missing"] }, "source_materials_percent": { "type": "integer", "minimum": 0, "maximum": 100 }, "stale_reasons": { "$ref": "#/$defs/Strings" }, "dirty_reasons": { "$ref": "#/$defs/Strings" }, "missing_sections": { "$ref": "#/$defs/Strings" } }
    },
    "TextSummary": {
      "type": "object", "additionalProperties": false,
      "properties": { "text": { "$ref": "#/$defs/String" }, "analysis": { "$ref": "#/$defs/String" }, "overview": { "$ref": "#/$defs/String" }, "brief": { "$ref": "#/$defs/String" }, "report_excerpt": { "$ref": "#/$defs/String" }, "key_takeaways": { "$ref": "#/$defs/Strings" } }
    },
    "TaxonomyRoute": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "definition": { "$ref": "#/$defs/String" }, "core_problem": { "$ref": "#/$defs/String" }, "mechanism": { "$ref": "#/$defs/String" }, "strengths": { "$ref": "#/$defs/Strings" }, "limitations": { "$ref": "#/$defs/Strings" }, "maturity": { "$ref": "#/$defs/String" }, "representative_papers": { "$ref": "#/$defs/Strings" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "TaxonomyAxis": {
      "type": "object", "additionalProperties": false, "required": ["axis_type", "nodes"],
      "properties": { "axis_type": { "enum": ["problem_formulation", "technical_mechanism", "evidence_scope", "research_route", "application_context"] }, "axis_rationale": { "$ref": "#/$defs/String" }, "nodes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/TaxonomyRoute" } } }
    },
    "Taxonomy": {
      "type": "object", "additionalProperties": false,
      "properties": { "summary": { "$ref": "#/$defs/TextSummary" }, "axes": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/TaxonomyAxis" } }, "nodes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/TaxonomyRoute" } } }
    },
    "Claim": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "text": { "$ref": "#/$defs/String" }, "analysis": { "$ref": "#/$defs/String" }, "scope": { "$ref": "#/$defs/String" }, "applicability": { "$ref": "#/$defs/String" }, "limitations": { "$ref": "#/$defs/Strings" }, "confidence": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "ImprovementDimension": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "analysis": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "ImprovementDimensions": {
      "type": "object", "additionalProperties": false, "required": ["summary", "dimensions"],
      "properties": { "summary": { "$ref": "#/$defs/TextSummary" }, "dimensions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/ImprovementDimension" } } }
    },
    "TimelineEvent": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "label": { "$ref": "#/$defs/String" }, "year": { "type": "integer" }, "description": { "$ref": "#/$defs/String" }, "historical_role": { "$ref": "#/$defs/String" }, "phase": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "Timeline": {
      "type": "object", "additionalProperties": false, "required": ["summary", "events"],
      "properties": { "summary": { "$ref": "#/$defs/TextSummary" }, "events": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/TimelineEvent" } } }
    },
    "Debate": {
      "type": "object", "additionalProperties": false, "required": ["title", "current_judgment", "source_paper_refs"],
      "properties": { "id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "current_judgment": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "FutureDirection": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "direction_type": { "enum": ["method_limitation", "evaluation_gap", "data_or_benchmark_need", "application_extension", "theory_or_mechanism_question", "integration_opportunity"] }, "current_limitation": { "$ref": "#/$defs/String" }, "future_direction": { "$ref": "#/$defs/String" }, "rationale": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "WritingStrategy": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "review_thesis": { "$ref": "#/$defs/String" }, "writing_strategy": { "$ref": "#/$defs/String" }, "section_plan": { "$ref": "#/$defs/Strings" }, "best_for": { "$ref": "#/$defs/String" }, "risks": { "$ref": "#/$defs/String" }, "source_paper_refs": { "$ref": "#/$defs/Strings" } }
    },
    "ReviewOutline": {
      "type": "object", "additionalProperties": false,
      "properties": { "topic_importance": { "$ref": "#/$defs/String" }, "writing_strategies": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/WritingStrategy" } }, "recommended_strategy_id": { "$ref": "#/$defs/String" } }
    },
    "Coverage": {
      "type": "object", "additionalProperties": false,
      "properties": { "verdict": { "$ref": "#/$defs/String" }, "reason": { "$ref": "#/$defs/String" }, "caveats": { "$ref": "#/$defs/Strings" }, "external_context_summary": { "$ref": "#/$defs/String" }, "suggested_collection_directions": { "$ref": "#/$defs/Strings" } }
    },
    "Statistics": {
      "type": "object", "additionalProperties": false,
      "properties": { "paper_count": { "type": "integer", "minimum": 0 }, "time_span": { "type": "object", "additionalProperties": false, "required": ["earliest", "latest"], "properties": { "earliest": { "$ref": "#/$defs/String" }, "latest": { "$ref": "#/$defs/String" } } }, "route_coverage": { "type": "object", "additionalProperties": false, "required": ["routes"], "properties": { "routes": { "type": "integer", "minimum": 0 } } }, "coverage_verdict": { "$ref": "#/$defs/String" } }
    },
    "SynthesisReport": {
      "type": "object", "additionalProperties": false,
      "properties": { "title": { "$ref": "#/$defs/String" }, "markdown": { "$ref": "#/$defs/String" }, "summary": { "$ref": "#/$defs/String" }, "sections": { "$ref": "#/$defs/Strings" } }
    },
    "ArtifactEntry": {
      "type": "object", "additionalProperties": false,
      "properties": { "key": { "$ref": "#/$defs/String" }, "path": { "$ref": "#/$defs/String" }, "hash": { "type": "string", "maxLength": 80 }, "skill_id": { "$ref": "#/$defs/String" }, "stage_id": { "$ref": "#/$defs/String" } }
    },
    "SourceArtifacts": {
      "type": "object", "additionalProperties": false,
      "properties": { "resolver_manifest": { "$ref": "#/$defs/ArtifactEntry" }, "prepare_handoff": { "$ref": "#/$defs/ArtifactEntry" }, "core_handoff": { "$ref": "#/$defs/ArtifactEntry" } }
    },
    "TopicArtifact": {
      "type": "object", "additionalProperties": false,
      "properties": { "topic": { "$ref": "#/$defs/TopicDefinition" }, "summary": { "$ref": "#/$defs/TextSummary" }, "taxonomy": { "$ref": "#/$defs/Taxonomy" }, "improvement_dimensions": { "$ref": "#/$defs/ImprovementDimensions" }, "claims": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/Claim" } }, "timeline_events": { "$ref": "#/$defs/Timeline" }, "source_papers": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ResolvedPaper" } }, "debates": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Debate" } }, "coverage": { "$ref": "#/$defs/Coverage" }, "statistics": { "$ref": "#/$defs/Statistics" }, "synthesis_report": { "$ref": "#/$defs/SynthesisReport" }, "future_directions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/FutureDirection" } }, "review_outline": { "$ref": "#/$defs/ReviewOutline" }, "source_artifacts": { "$ref": "#/$defs/SourceArtifacts" }, "diagnostics": { "$ref": "#/$defs/Strings" } }
    },
    "TopicManifest": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_id": { "$ref": "#/$defs/String" }, "schema_version": { "$ref": "#/$defs/String" }, "topic_id": { "$ref": "#/$defs/String" }, "operation": { "$ref": "#/$defs/String" }, "language": { "$ref": "#/$defs/String" }, "sections": { "type": "object", "maxProperties": 256, "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,127}$": { "$ref": "#/$defs/ArtifactEntry" } }, "additionalProperties": false }, "sidecars": { "type": "object", "maxProperties": 64, "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]{0,127}$": { "$ref": "#/$defs/ArtifactEntry" } }, "additionalProperties": false } }
    },
    "TopicMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_id": { "$ref": "#/$defs/String" }, "schema_version": { "$ref": "#/$defs/String" }, "topic_id": { "$ref": "#/$defs/String" }, "language": { "$ref": "#/$defs/String" }, "updated_at": { "$ref": "#/$defs/String" }, "paper_count": { "type": "integer", "minimum": 0 }, "external_literature_count": { "type": "integer", "minimum": 0 }, "prospective_topic_relation_proposals": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/TopicRelationProposal" } } }
    },
    "TopicRelationProposal": {
      "type": "object", "additionalProperties": false,
      "properties": { "source_topic_id": { "$ref": "#/$defs/String" }, "target_topic_id": { "$ref": "#/$defs/String" }, "target_title": { "$ref": "#/$defs/String" }, "relation": { "$ref": "#/$defs/String" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence_refs": { "$ref": "#/$defs/Strings" } }
    },
    "TopicDigestContext": {
      "type": "object", "additionalProperties": false, "required": ["topic_id", "title", "definition", "language", "updated_at", "summary", "paper_count", "external_literature_count"],
      "properties": { "topic_id": { "$ref": "#/$defs/String" }, "title": { "$ref": "#/$defs/String" }, "definition": { "$ref": "#/$defs/String" }, "language": { "$ref": "#/$defs/String" }, "updated_at": { "$ref": "#/$defs/String" }, "summary": { "$ref": "#/$defs/TextSummary" }, "paper_count": { "type": "integer", "minimum": 0 }, "external_literature_count": { "type": "integer", "minimum": 0 } }
    },
    "TopicSemanticContext": {
      "type": "object", "additionalProperties": false, "required": ["topic_id", "language", "topic_definition", "topic_resolver", "resolved_paper_set"],
      "properties": { "topic_id": { "$ref": "#/$defs/String" }, "language": { "$ref": "#/$defs/String" }, "topic_definition": { "$ref": "#/$defs/TopicDefinition" }, "topic_resolver": { "$ref": "#/$defs/TopicResolver" }, "resolved_paper_set": { "$ref": "#/$defs/ResolvedPaperSet" }, "prospective_topic_relation_proposals": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/TopicRelationProposal" } }, "topic": { "$ref": "#/$defs/TopicDefinition" }, "summary": { "$ref": "#/$defs/TextSummary" }, "taxonomy": { "$ref": "#/$defs/Taxonomy" }, "comparison_matrix": { "$ref": "#/$defs/ComparisonMatrix" }, "improvement_dimensions": { "$ref": "#/$defs/ImprovementDimensions" }, "claims": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/Claim" } }, "timeline_events": { "$ref": "#/$defs/Timeline" }, "source_papers": { "type": "array", "maxItems": 25000, "items": { "$ref": "#/$defs/ResolvedPaper" } }, "debates": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Debate" } }, "future_directions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/FutureDirection" } }, "review_outline": { "$ref": "#/$defs/ReviewOutline" }, "synthesis_report": { "$ref": "#/$defs/SynthesisReport" }, "markdown": { "$ref": "#/$defs/String" } }
    },
    "ComparisonMatrix": {
      "type": "object", "additionalProperties": false,
      "properties": { "columns": { "$ref": "#/$defs/Strings" }, "rows": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/StringMap" } } }
    },
    "SourcePaperTriage": {
      "type": "object", "maxProperties": 25000, "patternProperties": { "^.{1,512}$": { "$ref": "#/$defs/TriageRecord" } }, "additionalProperties": false
    },
    "TriageRecord": {
      "type": "object", "additionalProperties": false, "required": ["paper_ref"],
      "properties": { "paper_ref": { "$ref": "#/$defs/String" }, "relevance_level": { "$ref": "#/$defs/String" }, "relevance_reason": { "$ref": "#/$defs/String" }, "core_digest": { "$ref": "#/$defs/String" }, "caveats": { "$ref": "#/$defs/Strings" } }
    },
    "Freshness": {
      "type": "object", "additionalProperties": false,
