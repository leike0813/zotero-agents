{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/observability.schema.json",
  "$defs": {
    "TraceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "traceId", "spanId", "attempt"],
      "properties": {
        "schema": { "const": "synthesis-sidecar-observation.v2" },
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "spanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "parentSpanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "attempt": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "Identities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/identifier" },
        "operation": { "$ref": "common.schema.json#/$defs/identifier" },
        "trigger": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "queueWaitMs": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "requestBytes": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "responseBytes": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "sqlQueryCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "sqlWriteCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "budgetBytes": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "returnedCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "totalCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "batchOrdinal": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "Facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticStatus": { "$ref": "common.schema.json#/$defs/identifier" },
        "algorithm": { "$ref": "common.schema.json#/$defs/identifier" },
        "graphHash": { "$ref": "common.schema.json#/$defs/sha256" },
        "matchingHash": { "$ref": "common.schema.json#/$defs/sha256" },
        "proposalCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "factCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "warningCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "nodeCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "edgeCount": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        }
      }
    },
    "ObservationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "traceId",
        "spanId",
        "attempt",
        "source",
        "boundary",
        "phase",
        "outcome",
        "occurredAtMs"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-observation.v2" },
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "spanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "parentSpanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "attempt": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "source": { "enum": ["host", "rust-sidecar", "child-worker"] },
        "boundary": {
          "enum": [
            "supervisor",
            "process",
            "host-rpc",
            "reverse-host",
            "child-worker",
            "transfer",
            "operation"
          ]
        },
        "phase": { "$ref": "common.schema.json#/$defs/identifier" },
        "outcome": {
          "enum": ["started", "succeeded", "failed", "canceled", "timed-out"]
        },
        "code": { "$ref": "common.schema.json#/$defs/identifier" },
        "occurredAtMs": {
          "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
        },
        "identities": { "$ref": "#/$defs/Identities" },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "facts": { "$ref": "#/$defs/Facts" }
      }
    }
  }
}
