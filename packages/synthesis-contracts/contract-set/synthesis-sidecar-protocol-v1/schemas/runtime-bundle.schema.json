{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/runtime-bundle.schema.json",
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "RelativePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+$" },
    "File": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "executable"], "properties": { "path": { "$ref": "#/$defs/RelativePath" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }, "sha256": { "$ref": "#/$defs/Hash" }, "executable": { "type": "boolean" } } },
    "Provenance": { "type": "object", "additionalProperties": false, "required": ["sourceFingerprint", "toolchain", "cargoLockSha256", "licenseInventory"], "properties": { "sourceFingerprint": { "$ref": "#/$defs/Hash" }, "toolchain": { "type": "string", "minLength": 1, "maxLength": 128 }, "cargoLockSha256": { "$ref": "#/$defs/Hash" }, "licenseInventory": { "$ref": "#/$defs/RelativePath" } } },
    "BundleV3": { "type": "object", "additionalProperties": false, "required": ["schema", "bundleId", "implementation", "serviceVersion", "protocolVersion", "target", "targetTriple", "executable", "buildFingerprint", "capabilities", "createdAt", "expiresAt", "provenance", "files"], "properties": { "schema": { "const": "synthesis-sidecar-runtime-bundle.v3" }, "bundleId": { "$ref": "#/$defs/Hash" }, "implementation": { "const": "rust-native" }, "serviceVersion": { "$ref": "common.schema.json#/$defs/identifier" }, "protocolVersion": { "const": "synthesis-sidecar.v1" }, "target": { "$ref": "lifecycle.schema.json#/$defs/Target" }, "targetTriple": { "$ref": "lifecycle.schema.json#/$defs/Triple" }, "executable": { "$ref": "#/$defs/RelativePath" }, "buildFingerprint": { "$ref": "#/$defs/Hash" }, "capabilities": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "system.schema.json#/$defs/Capability" } }, "createdAt": { "type": "string", "minLength": 1, "maxLength": 64 }, "expiresAt": { "type": ["string", "null"], "maxLength": 64 }, "provenance": { "$ref": "#/$defs/Provenance" }, "files": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/File" } } } },
    "PointerV2": { "type": "object", "additionalProperties": false, "required": ["schema", "bundleId"], "properties": { "schema": { "const": "synthesis-sidecar-runtime-pointer.v2" }, "bundleId": { "$ref": "#/$defs/Hash" } } }
  }
}
