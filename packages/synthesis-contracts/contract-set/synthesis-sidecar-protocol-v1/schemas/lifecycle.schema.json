{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/synthesis/sidecar-protocol/v1/lifecycle.schema.json",
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Target": {
      "enum": [
        "win32-x64",
        "darwin-x64",
        "darwin-arm64",
        "linux-x86",
        "linux-x64",
        "linux-arm",
        "linux-arm64"
      ]
    },
    "Triple": {
      "enum": [
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "i686-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        "aarch64-unknown-linux-gnu"
      ]
    },
    "PlatformSignature": {
      "$ref": "system.schema.json#/$defs/PlatformSignature"
    },
    "ReverseHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "authorizationToken"],
      "properties": {
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authorizationToken": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      }
    },
    "LaunchConfigV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "libraryId",
        "profileRuntimeRoot",
        "runtimeRootId",
        "dataRootId",
        "bundleId",
        "implementation",
        "target",
        "targetTriple",
        "buildFingerprint",
        "platformSignature",
        "serviceVersion",
        "protocolVersion",
        "schemaVersion",
        "supervisorInstanceId",
        "repositoryDbPath",
        "canonicalRoot",
        "reverseHost",
        "clientToken",
        "lifecycleToken",
        "port"
      ],
      "properties": {
        "schema": { "const": "synthesis-sidecar-launch-config.v3" },
        "profileId": { "$ref": "#/$defs/Hash" },
        "libraryId": { "type": "integer", "minimum": 1 },
        "profileRuntimeRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "runtimeRootId": { "$ref": "#/$defs/Hash" },
        "dataRootId": { "$ref": "#/$defs/Hash" },
        "bundleId": { "$ref": "#/$defs/Hash" },
        "implementation": { "const": "rust-native" },
        "target": { "$ref": "#/$defs/Target" },
        "targetTriple": { "$ref": "#/$defs/Triple" },
        "buildFingerprint": { "$ref": "#/$defs/Hash" },
        "platformSignature": { "$ref": "#/$defs/PlatformSignature" },
        "serviceVersion": { "$ref": "common.schema.json#/$defs/identifier" },
        "protocolVersion": { "const": "synthesis-sidecar.v1" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/identifier" },
        "supervisorInstanceId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "diagnosticsEnabled": { "type": "boolean" },
        "repositoryDbPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "canonicalRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reverseHost": { "$ref": "#/$defs/ReverseHost" },
        "clientToken": { "type": "string", "minLength": 32, "maxLength": 256 },
        "lifecycleToken": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "port": { "const": 0 }
      }
    },
    "DiscoveryBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "supervisorInstanceId",
        "serviceInstanceId",
        "bundleId",
        "implementation",
        "target",
        "targetTriple",
        "buildFingerprint",
        "platformSignature",
        "serviceVersion",
        "protocolVersion",
        "schemaVersion",
        "runtimeRootId",
        "dataRootId",
        "host",
        "port",
        "pid",
        "lifecycleState",
        "tokenLocator",
        "capabilities"
      ],
      "properties": {
        "schema": {
          "enum": [
            "synthesis-sidecar-discovery.v2",
            "synthesis-sidecar-discovery.v5"
          ]
        },
        "profileId": { "$ref": "#/$defs/Hash" },
        "supervisorInstanceId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "serviceInstanceId": { "$ref": "common.schema.json#/$defs/identifier" },
        "bundleId": { "$ref": "#/$defs/Hash" },
        "implementation": { "const": "rust-native" },
        "target": { "$ref": "#/$defs/Target" },
        "targetTriple": { "$ref": "#/$defs/Triple" },
        "buildFingerprint": { "$ref": "#/$defs/Hash" },
        "platformSignature": { "$ref": "#/$defs/PlatformSignature" },
        "serviceVersion": { "$ref": "common.schema.json#/$defs/identifier" },
        "protocolVersion": { "const": "synthesis-sidecar.v1" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/identifier" },
        "runtimeRootId": { "$ref": "#/$defs/Hash" },
        "dataRootId": { "$ref": "#/$defs/Hash" },
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 2 },
        "lifecycleState": { "const": "ready" },
        "tokenLocator": { "const": "supervisor-session" },
        "capabilities": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "system.schema.json#/$defs/Capability" }
        }
      }
    },
    "DiscoveryV2": {
      "allOf": [
        { "$ref": "#/$defs/DiscoveryBase" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "synthesis-sidecar-discovery.v2" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ProductionDiscoveryV5": {
      "allOf": [
        { "$ref": "#/$defs/DiscoveryBase" },
        {
          "type": "object",
          "properties": {
            "schema": { "const": "synthesis-sidecar-discovery.v5" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
