  "cards": [
    {
      "dot": "cyan",
      "title": "插件本体保持可插拔",
      "items": [
        "界面只提供通用入口，业务逻辑由工作流包与 Skill 包声明",
        "启动时扫描工作流目录，加载 manifest 与 hooks 并生成菜单",
        "Provider 由 request kind 与 backend type 解析，协议由各自实现"
      ]
    },
    {
      "dot": "emerald",
      "title": "两个方向的外联",
      "items": [
        "出站：界面触发 workflow，JobQueue 经 Provider 调用 ACP 或 SkillRunner",
        "入站：外部 Agent 经 Host Bridge 调用 Zotero 能力",
        "ACP 走 stdio；Windows 由 zotero-acp-bridge 转 WebSocket"
      ]
    },
    {
      "dot": "amber",
      "title": "权威与状态",
      "items": [
        "Broker 是 Zotero 能力语义的唯一事实源，Host API 与 Host Bridge 只是投影",
        "SQLite 与 prefs 保存 mutation 证据、任务状态与后端配置",
        "Synthesis sidecar 通过 discovery 文件发布就绪状态"
      ]
    }
  ]
