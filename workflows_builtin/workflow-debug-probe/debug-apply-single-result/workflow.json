{
  "schemaVersion": 2,
  "id": "debug-apply-single-result",
  "label": "Debug: Apply Single Result",
  "description": "Run the Debug: Apply Single Result diagnostic workflow to verify its named workflow-engine behavior.",
  "executionModes": ["auto"],
  "version": "0.1.0",
  "provider": "skillrunner",
  "debug_only": true,
  "trigger": {
    "requiresSelection": false
  },
  "inputs": {
    "member": {
      "kind": "selection"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "validateSelection": {
    "select": {
      "policy": "selection"
    },
    "filters": []
  },
  "request": {
    "kind": "skillrunner.job.v1",
    "create": {
      "mode": "auto"
    }
  },
  "execution": {
    "feedback": {
      "showNotifications": true
    }
  },
  "result": {
    "fetch": { "type": "result" }
  },
  "hooks": {
    "buildRequest": "../hooks/buildDebugApplyContractRequest.mjs",
    "applyResult": "../hooks/applyDebugApplyContractResult.mjs"
  }
}
