{
  "schemaVersion": 2,
  "id": "import-notes",
  "label": "Import Notes",
  "description": "Import supported external analysis files and upsert their generated Zotero notes.",
  "executionModes": ["auto"],
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "parent"
    },
    "grouping": {
      "mode": "each"
    }
  },
  "validateSelection": {
    "require": {
      "selection": {
        "allowMixed": false,
        "counts": {
          "parents": {
            "exact": 1
          },
          "attachments": {
            "exact": 0
          },
          "notes": {
            "exact": 0
          },
          "children": {
            "exact": 0
          }
        }
      }
    },
    "select": {
      "policy": "input-member",
      "source": "selected"
    },
    "filters": []
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
