{
  "schemaVersion": 2,
  "id": "import-notes",
  "label": "Import Notes",
  "description": "Import supported external analysis files and upsert their generated Zotero notes.",
  "executionModes": ["auto"],
  "supportedInvocationModes": ["interactive", "non-interactive"],
  "resourceRequirements": [
    {
      "id": "digest",
      "direction": "input",
      "kind": "file",
      "cardinality": "one",
      "required": false,
      "accept": { "extensions": [".md"] }
    },
    {
      "id": "references",
      "direction": "input",
      "kind": "file",
      "cardinality": "one",
      "required": false,
      "accept": { "extensions": [".json"] }
    },
    {
      "id": "citation-analysis",
      "direction": "input",
      "kind": "file",
      "cardinality": "one",
      "required": false,
      "accept": { "extensions": [".json"] }
    },
    {
      "id": "literature-score",
      "direction": "input",
      "kind": "file",
      "cardinality": "one",
      "required": false,
      "accept": { "extensions": [".json"] }
    },
    {
      "id": "custom-notes",
      "direction": "input",
      "kind": "file",
      "cardinality": "many",
      "required": false,
      "accept": { "extensions": [".md"] }
    }
  ],
  "parameters": {
    "conflictPolicy": {
      "type": "string",
      "enum": ["error", "overwrite", "skip"],
      "default": "error"
    }
  },
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "parent"
    },
    "grouping": {
      "mode": "each"
    }
  },
  "validateSelection": {
    "require": {
      "selection": {
        "allowMixed": false,
        "counts": {
          "parents": {
            "exact": 1
          },
          "attachments": {
            "exact": 0
          },
          "notes": {
            "exact": 0
          },
          "children": {
            "exact": 0
          }
        }
      }
    },
    "select": {
      "policy": "input-member",
      "source": "selected"
    },
    "filters": []
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
