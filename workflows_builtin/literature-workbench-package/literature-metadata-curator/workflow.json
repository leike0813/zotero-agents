{
  "schemaVersion": 2,
  "id": "literature-metadata-curator",
  "label": "Literature Metadata Curator",
  "description": "Audit and repair bibliographic metadata for selected literature using identifier and search evidence.",
  "executionModes": ["auto"],
  "provider": "skillrunner",
  "version": "0.3.0",
  "display": {
    "core": true,
    "emoji": "📇"
  },
  "taskNameTemplate": "Curate literature metadata",
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "parent"
    },
    "grouping": {
      "mode": "each"
    }
  },
  "parameters": {
    "skip_identifier_fast_path": {
      "type": "boolean",
      "title": "Skip identifier fast path",
      "description": "Bypass Zotero identifier lookup and run literature-metadata-search directly.",
      "default": false
    }
  },
  "validateSelection": {
    "select": {
      "policy": "input-member",
      "source": "related"
    },
    "filters": []
  },
  "request": {
    "kind": "skillrunner.job.v1",
    "create": {
      "skill_id": "literature-metadata-search",
      "mode": "auto"
    }
  },
  "execution": {
    "poll_interval_ms": 2000
  },
  "result": {
    "fetch": {
      "type": "result"
    },
    "expects": {
      "result_json": "result/result.json"
    }
  },
  "hooks": {
    "preflight": "hooks/preflight.mjs",
    "buildRequest": "hooks/buildRequest.mjs",
    "applyResult": "hooks/applyResult.mjs"
  }
}
