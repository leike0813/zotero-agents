{
  "schemaVersion": 2,
  "id": "tag-regulator",
  "label": "Tag Regulator",
  "description": "Normalize and infer selected literature tags against the controlled vocabulary.",
  "executionModes": ["auto"],
  "provider": "skillrunner",
  "version": "0.1.0",
  "display": {
    "core": true,
    "emoji": "🏷️"
  },
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "parent"
    },
    "grouping": {
      "mode": "each"
    }
  },
  "validateSelection": {
    "select": {
      "policy": "input-member",
      "source": "selected"
    },
    "filters": []
  },
  "request": {
    "kind": "skillrunner.job.v1",
    "create": {
      "mode": "auto"
    }
  },
  "parameters": {
    "infer_tag": {
      "type": "boolean",
      "title": "Infer Tag",
      "default": true
    },
    "tag_note_language": {
      "type": "string",
      "title": "Tag Note Language",
      "enum": [
        "zh-CN",
        "en-US",
        "ja-JP",
        "ko-KR",
        "de-DE",
        "fr-FR",
        "es-ES",
        "ru-RU"
      ],
      "allowCustom": true,
      "default": "zh-CN"
    }
  },
  "result": {
    "fetch": {
      "type": "result"
    }
  },
  "hooks": {
    "buildRequest": "hooks/buildRequest.mjs",
    "applyResult": "hooks/applyResult.mjs"
  }
}
