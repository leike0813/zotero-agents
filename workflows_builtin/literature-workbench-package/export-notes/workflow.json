{
  "schemaVersion": 2,
  "id": "export-notes",
  "label": "Export Notes",
  "description": "Export supported generated Zotero notes as editable external files.",
  "executionModes": ["auto"],
  "supportedInvocationModes": ["interactive", "non-interactive"],
  "resourceRequirements": [
    {
      "id": "notes",
      "direction": "output",
      "kind": "archive",
      "cardinality": "one",
      "required": true,
      "suggestedName": "notes-export.zip",
      "accept": { "contentTypes": ["application/zip"] }
    }
  ],
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "generated-note"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "validateSelection": {
    "select": {
      "policy": "generated-note-candidates"
    },
    "filters": []
  },
  "hooks": {
    "buildRequest": "hooks/buildRequest.mjs",
    "applyResult": "hooks/applyResult.mjs"
  }
}
