{
  "schemaVersion": 2,
  "id": "import-literature-bundle",
  "label": "Import Literature Bundle",
  "description": "Import a literature bundle and reconcile its supported Zotero literature artifacts.",
  "executionModes": ["auto"],
  "supportedInvocationModes": ["interactive", "non-interactive"],
  "resourceRequirements": [
    {
      "id": "bundle",
      "direction": "input",
      "kind": "archive",
      "cardinality": "one",
      "required": true,
      "accept": { "extensions": [".zip"] }
    },
    {
      "id": "research-import-files",
      "direction": "input",
      "kind": "file",
      "cardinality": "many",
      "required": false,
      "accept": { "maxCount": 1000, "maxBytes": 17179869184 }
    }
  ],
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": false
  },
  "inputs": {
    "member": {
      "kind": "selection"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "parameters": {
    "targetLibraryId": {
      "type": "number",
      "integer": true,
      "min": 1,
      "title": "Target Library ID",
      "description": "Explicit destination library for non-interactive import. A target collection can also identify the library."
    },
    "targetCollection": {
      "type": "string",
      "default": "",
      "title": "Target Collection",
      "description": "Optional destination collection as libraryId:collectionKey. Must belong to the explicit target library when both are set.",
      "optionsSource": {
        "kind": "zotero.collections",
        "library": "current",
        "includeEmpty": true,
        "valueFormat": "collectionRef",
        "labelFormat": "path"
      }
    }
  },
  "validateSelection": {
    "select": {
      "policy": "selection"
    },
    "filters": []
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
