{
  "schemaVersion": 2,
  "id": "export-literature-bundle",
  "label": "Export Literature Bundle",
  "description": "Export selected literature and its generated analysis artifacts into a portable bundle.",
  "executionModes": ["auto"],
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": true
  },
  "inputs": {
    "member": {
      "kind": "selection"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "validateSelection": {
    "require": {
      "selection": {
        "allowMixed": false,
        "counts": {
          "parents": {
            "min": 1
          },
          "attachments": {
            "exact": 0
          },
          "notes": {
            "exact": 0
          },
          "children": {
            "exact": 0
          }
        }
      }
    },
    "select": {
      "policy": "selection"
    },
    "filters": []
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
