{
  "id": "export-literature-bundle",
  "label": "Export Literature Bundle",
  "description": "Export selected literature and its generated analysis artifacts into a portable bundle.",
  "executionModes": ["auto"],
  "version": "1.0.0",
  "provider": "pass-through",
  "inputs": {
    "unit": "workflow"
  },
  "validateSelection": {
    "require": {
      "allowMixed": false,
      "counts": {
        "parents": { "min": 1 },
        "attachments": { "exact": 0 },
        "notes": { "exact": 0 },
        "children": { "exact": 0 }
      }
    }
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
