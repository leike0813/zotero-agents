{
  "schemaVersion": 2,
  "id": "export-literature-bundle",
  "label": "Export Literature Bundle",
  "description": "Export literature from the current selection, a Zotero collection, or the current library into a portable Research Product.",
  "executionModes": ["auto"],
  "version": "1.0.0",
  "provider": "pass-through",
  "trigger": {
    "requiresSelection": false
  },
  "inputs": {
    "member": {
      "kind": "selection"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "validateSelection": {
    "require": {
      "selection": {
        "allowMixed": false,
        "counts": {
          "attachments": { "exact": 0 },
          "notes": { "exact": 0 },
          "children": { "exact": 0 }
        }
      }
    },
    "select": {
      "policy": "selection"
    },
    "filters": []
  },
  "parameters": {
    "mode": {
      "type": "string",
      "title": "Export mode",
      "description": "Choose the current selection, a collection, or the current library.",
      "enum": ["selection", "collection", "library"],
      "default": "selection"
    },
    "targetCollection": {
      "type": "string",
      "title": "Target collection",
      "description": "Required in collection mode; use libraryId:collectionKey.",
      "required": false,
      "allowCustom": false,
      "optionsSource": {
        "kind": "zotero.collections",
        "library": "current",
        "includeEmpty": true,
        "valueFormat": "collectionRef",
        "labelFormat": "path"
      }
    },
    "sourceOnly": {
      "type": "boolean",
      "title": "仅导出原文",
      "description": "导出扁平结构的原文包，不包含笔记和分析工件，无法被「导入文献包」工作流导入。",
      "default": false
    }
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
