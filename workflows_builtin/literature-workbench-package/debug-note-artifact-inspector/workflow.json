{
  "schemaVersion": 2,
  "id": "debug-note-artifact-inspector",
  "label": "Debug: Note Artifact Inspector",
  "description": "Run the Debug: Note Artifact Inspector diagnostic workflow to verify its named workflow-engine behavior.",
  "executionModes": ["auto"],
  "version": "0.1.0",
  "provider": "pass-through",
  "debug_only": true,
  "inputs": {
    "member": {
      "kind": "selection"
    },
    "grouping": {
      "mode": "all"
    }
  },
  "trigger": {
    "requiresSelection": true
  },
  "validateSelection": {
    "select": {
      "policy": "selection"
    },
    "filters": []
  },
  "execution": {
    "feedback": {
      "showNotifications": true
    }
  },
  "hooks": {
    "applyResult": "hooks/applyResult.mjs"
  }
}
