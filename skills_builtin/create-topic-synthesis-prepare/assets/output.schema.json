{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "handoff",
        "operation",
        "db_path",
        "handoff_manifest_path",
        "next_skill_id"
      ],
      "properties": {
        "kind": { "const": "topic_synthesis_handoff" },
        "handoff": { "const": "prepare_analysis_context" },
        "operation": { "const": "create" },
        "db_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the runtime state SQLite database.",
          "x-type": "artifact",
          "x-role": "runtime-state-db"
        },
        "handoff_manifest_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the handoff artifact manifest file.",
          "x-type": "artifact-manifest",
          "x-role": "artifact-manifest"
        },
        "next_skill_id": { "const": "topic-synthesis-core-enrichment" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "reason", "message"],
      "properties": {
        "kind": { "const": "topic_synthesis_canceled" },
        "status": { "const": "canceled" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Machine-readable reason code explaining the cancellation or failure."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation message."
        },
        "duplicate_topic_id": { "type": "string" },
        "topic_seed": { "type": "string" },
        "topic_id": { "type": "string" }
      }
    }
  ]
}
