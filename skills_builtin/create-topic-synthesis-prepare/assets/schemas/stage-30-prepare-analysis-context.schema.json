{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_30_prepare_analysis_context.schema.json",
  "title": "Stage 30 prepare analysis context payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/topic-domain.PaperAssessment" },
          {
            "required": [
              "paper_ref",
              "relevance_level",
              "relevance_reason",
              "core_digest",
              "caveats"
            ],
            "properties": {
              "paper_ref": { "type": "string" },
              "relevance_level": {
                "enum": ["core", "related", "external", "irrelevant", "unknown"]
              },
              "relevance_reason": { "type": "string" },
              "core_digest": { "type": "string" },
              "caveats": { "type": "array" }
            }
          }
        ]
      }
    }
  },
  "examples": [
    {
      "assessments": [
        {
          "paper_ref": "1:ABC",
          "relevance_level": "core",
          "relevance_reason": "",
          "core_digest": "",
          "caveats": []
        }
      ]
    }
  ],
  "definitions": {
    "topic-domain.PaperAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_ref": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
        "relevance_level": { "$ref": "#/definitions/topic-domain.String" },
        "relevance_reason": { "$ref": "#/definitions/topic-domain.String" },
        "core_digest": { "$ref": "#/definitions/topic-domain.String" },
        "caveats": { "$ref": "#/definitions/topic-domain.Strings" }
      }
    },
    "topic-domain.NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "topic-domain.String": { "type": "string", "maxLength": 65536 },
    "topic-domain.Strings": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/definitions/topic-domain.String" }
    }
  }
}
