{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_10_create_topic_context.schema.json",
  "title": "Stage 10 create topic context payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_title",
    "aliases",
    "definition",
    "scope_include",
    "scope_exclude",
    "target_decision"
  ],
  "properties": {
    "topic_title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "scope_include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "candidate_topic_ids", "reason"],
      "properties": {
        "action": {
          "enum": [
            "create_new",
            "use_planned_topic",
            "cancel_materialized_duplicate"
          ]
        },
        "selected_topic_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "examples": [
    {
      "topic_title": "DETR-style Object Detection",
      "aliases": [],
      "definition": "Query-based object detection methods derived from DETR.",
      "scope_include": [],
      "scope_exclude": [],
      "target_decision": {
        "action": "create_new",
        "candidate_topic_ids": [],
        "reason": "No materialized or active Planned Topic represents the same identity."
      }
    }
  ]
}
