{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_20_resolver_and_workset.schema.json",
  "title": "Stage 20 resolver and workset payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolver", "resolver_reasoning", "operation_intent"],
  "properties": {
    "resolver": {
      "$ref": "#/definitions/client-topic-workbench.TopicResolverProposal"
    },
    "resolver_reasoning": { "type": "string" },
    "operation_intent": { "enum": ["create", "unknown"] }
  },
  "examples": [
    {
      "resolver": {
        "tag": { "and": ["object-detection", "detr"] },
        "combine": "union"
      },
      "resolver_reasoning": "",
      "operation_intent": "create"
    }
  ],
  "definitions": {
    "client-topic-workbench.TopicResolverProposal": {
      "properties": {
        "tag": {
          "minProperties": 1,
          "properties": {
            "and": { "minItems": 1 },
            "or": { "minItems": 1 },
            "not": { "minItems": 1 }
          }
        }
      },
      "anyOf": [
        {
          "required": ["tag"],
          "properties": {
            "tag": {
              "$ref": "#/definitions/client-topic-workbench.ResolverTag"
            }
          }
        },
        {
          "required": ["paper_refs"],
          "properties": { "paper_refs": { "minItems": 1 } }
        },
        {
          "required": ["collection_key"],
          "properties": { "collection_key": { "minItems": 1 } }
        }
      ],
      "$ref": "#/definitions/client-topic-workbench.TopicPlanningSelector"
    },
    "client-topic-workbench.TopicPlanningSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_refs": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "collection_key": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "tag": { "$ref": "#/definitions/client-topic-workbench.ResolverTag" },
        "combine": { "enum": ["union", "intersection"] }
      }
    },
    "client-topic-workbench.Strings": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/definitions/client-topic-workbench.String" }
    },
    "client-topic-workbench.String": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "client-topic-workbench.ResolverTag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "and": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "or": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "not": { "$ref": "#/definitions/client-topic-workbench.Strings" }
      }
    }
  }
}
