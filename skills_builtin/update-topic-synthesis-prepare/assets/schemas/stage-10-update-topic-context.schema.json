{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_10_update_topic_context.schema.json",
  "title": "Stage 10 update decision and resolver payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["update_decision"],
  "properties": {
    "update_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason", "message"],
      "properties": {
        "action": { "enum": ["cancel", "continue"] },
        "reason": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "resolver": {
      "$ref": "#/definitions/client-topic-workbench.TopicResolverProposal"
    },
    "resolver_reasoning": { "type": "string" }
  },
  "examples": [
    {
      "update_decision": {
        "action": "continue",
        "reason": "The preflight audit shows new source material candidates.",
        "message": "Proceeding with a current-state update."
      },
      "resolver": { "paper_refs": ["1:DETR", "1:DINO"], "combine": "union" },
      "resolver_reasoning": "The proposal keeps the current resolver refs and adds newly relevant resolved papers."
    }
  ],
  "definitions": {
    "client-topic-workbench.TopicResolverProposal": {
      "allOf": [
        { "$ref": "#/definitions/client-topic-workbench.TopicPlanningSelector" }
      ],
      "properties": {
        "tag": {
          "minProperties": 1,
          "properties": {
            "and": { "minItems": 1 },
            "or": { "minItems": 1 },
            "not": { "minItems": 1 }
          }
        }
      },
      "anyOf": [
        { "required": ["tag"] },
        {
          "required": ["paper_refs"],
          "properties": { "paper_refs": { "minItems": 1 } }
        },
        {
          "required": ["collection_key"],
          "properties": { "collection_key": { "minItems": 1 } }
        }
      ]
    },
    "client-topic-workbench.TopicPlanningSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_refs": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "collection_key": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "tag": { "$ref": "#/definitions/client-topic-workbench.ResolverTag" },
        "combine": { "enum": ["union", "intersection"] }
      }
    },
    "client-topic-workbench.Strings": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/definitions/client-topic-workbench.String" }
    },
    "client-topic-workbench.String": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "client-topic-workbench.ResolverTag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "and": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "or": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "not": { "$ref": "#/definitions/client-topic-workbench.Strings" }
      }
    }
  }
}
