{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Host Bridge Connectivity Probe Result",
  "type": "object",
  "required": [
    "kind",
    "ok",
    "connection",
    "checks",
    "diagnostics",
    "failure_code",
    "failure_message"
  ],
  "properties": {
    "kind": { "const": "host_bridge_connectivity_probe_result" },
    "ok": { "type": "boolean", "description": "Whether all connectivity checks passed." },
    "connection": {
      "type": "object",
      "description": "Host Bridge connection details.",
      "required": [
        "cli_entry",
        "endpoint_source",
        "endpoint",
        "connection_mode",
        "token_present"
      ],
      "properties": {
        "cli_entry": { "type": "string", "description": "Path or command string of the Host Bridge CLI." },
        "endpoint_source": {
          "enum": ["argument", "env", "profile", "unknown"],
          "description": "How the endpoint was resolved."
        },
        "endpoint": { "type": "string", "description": "Resolved Host Bridge endpoint URL." },
        "connection_mode": {
          "enum": ["local", "remote", "unknown"],
          "description": "Detected connection mode: local or remote."
        },
        "token_present": { "type": "boolean", "description": "Whether an authentication token was found." },
        "profile_path": { "type": "string" },
        "profile_present": { "type": "boolean" },
        "env_endpoint_present": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "description": "Array of per-check results.",
      "items": {
        "type": "object",
        "required": ["id", "status", "duration_ms"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Check identifier." },
          "status": { "enum": ["passed", "failed", "skipped"], "description": "Result of this check: passed, failed, or skipped." },
          "duration_ms": { "type": "number", "description": "Duration of this check in milliseconds." },
          "failure_code": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "Extended diagnostic data object.",
      "properties": {
        "protocol": { "type": "string" },
        "capability_count": { "type": "number" },
        "remote_endpoint_detected": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "failure_code": {
      "type": "string",
      "description": "Machine-readable failure code. Empty string on success.",
      "enum": [
        "",
        "cli_not_found",
        "profile_missing",
        "endpoint_missing",
        "token_missing",
        "endpoint_unreachable",
        "auth_failed",
        "protocol_mismatch",
        "command_argument_invalid",
        "manifest_invalid",
        "capability_call_failed",
        "expected_local_but_remote",
        "expected_remote_but_local",
        "remote_endpoint_loopback"
      ]
    },
    "failure_message": { "type": "string", "description": "Human-readable failure description. Empty string on success." }
  },
  "additionalProperties": true
}
