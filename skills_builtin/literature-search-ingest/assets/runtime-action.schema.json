    "recordMetadataQualifiedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "candidate_id",
        "status",
        "identifier_status",
        "checked_sources",
        "match",
        "metadata",
        "evidence",
        "warnings",
        "needs_curation"
      ],
      "properties": {
        "action": {
          "const": "record_metadata"
        },
        "candidate_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "status": {
          "const": "qualified"
        },
        "identifier_status": {
          "type": "string",
          "enum": [
            "resolved",
            "identifier_not_found"
          ]
        },
        "checked_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "match": {
          "$ref": "#/definitions/metadataMatch"
        },
        "metadata": {
          "$ref": "#/definitions/resolvedMetadata"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/sourceEvidence"
          },
          "contains": {
            "type": "object",
            "required": [
              "source_role"
            ],
            "properties": {
              "source_role": {
                "const": "authoritative"
              }
            }
          }
        },
        "corroborating_signals": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/warning"
          }
        },
        "needs_curation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "method": {
                    "const": "identifier"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "normalized_identifier": {
                    "$ref": "#/definitions/normalizedIdentifier"
                  }
                },
                "required": [
                  "normalized_identifier"
                ]
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "identifiers": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "corroborating_signals": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/definitions/nonEmptyString"
                }
              }
            },
            "required": [
              "corroborating_signals"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metadata": {
                "type": "object",
                "properties": {
                  "creatorCompleteness": {
                    "enum": [
                      "incomplete",
                      "unknown"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "needs_curation": {
                "const": true
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/warning"
                },
                "contains": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "const": "native_creator_names_unverified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
