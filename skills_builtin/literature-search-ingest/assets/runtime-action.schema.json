{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "literature-search-ingest-runtime-action",
  "title": "Literature Search Ingest Gate Action",
  "oneOf": [
    {
      "$ref": "#/definitions/approveSearchPlanAction"
    },
    {
      "$ref": "#/definitions/recordDiscoveryAction"
    },
    {
      "$ref": "#/definitions/requestDiscoveryExpansionAction"
    },
    {
      "$ref": "#/definitions/approveIngestScopeAction"
    },
    {
      "$ref": "#/definitions/cancelWorkflowAction"
    },
    {
      "$ref": "#/definitions/recordMetadataAction"
    },
    {
      "$ref": "#/definitions/recordPdfProbeAction"
    }
  ],
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      },
      "uniqueItems": true
    },
    "queryLaneName": {
      "type": "string",
      "enum": [
        "core",
        "multilingual",
        "seed",
        "gap"
      ]
    },
    "queryLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "queries",
        "rationale"
      ],
      "properties": {
        "lane": {
          "$ref": "#/definitions/queryLaneName"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "uniqueItems": true
        },
        "rationale": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "sourceLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_class",
        "role",
        "fallback_sources"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source_class": {
          "type": "string",
          "enum": [
            "cross_disciplinary_index",
            "authoritative_publisher",
            "domain_index",
            "regional_index",
            "repository",
            "library_catalog",
            "citation_network",
            "public_web"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supplemental",
            "fallback"
          ]
        },
        "fallback_sources": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "searchScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date_range",
        "language_hints",
        "literature_types",
        "regions"
      ],
      "properties": {
        "date_range": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "language_hints": {
          "$ref": "#/definitions/stringArray"
        },
        "literature_types": {
          "$ref": "#/definitions/stringArray"
        },
        "regions": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "localCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "existing_identifiers",
        "reusable_seed_refs",
        "gaps"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "existing_identifiers": {
          "$ref": "#/definitions/stringArray"
        },
        "reusable_seed_refs": {
          "$ref": "#/definitions/stringArray"
        },
        "gaps": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "seedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "type",
        "used",
        "reason"
      ],
      "properties": {
        "ref": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "references",
            "citation_analysis",
            "digest",
            "topic_report",
            "metadata"
          ]
        },
        "used": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiers",
        "material_conflict",
        "batch_size"
      ],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ready",
              "needs_curation",
              "lead_only"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "ready"
              }
            },
            {
              "contains": {
                "const": "needs_curation"
              }
            },
            {
              "contains": {
                "const": "lead_only"
              }
            }
          ]
        },
        "material_conflict": {
          "const": "keep_separate"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "searchPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_mode",
        "objective",
        "discipline_or_application",
        "scope",
        "local_coverage",
        "seed_artifacts",
        "query_lanes",
        "source_lanes",
        "inclusion_criteria",
        "exclusion_criteria",
        "candidate_policy",
        "breadth",
        "stop_conditions",
        "pdf_policy"
      ],
      "properties": {
        "search_mode": {
          "type": "string",
          "enum": [
            "guided",
            "topic_expansion",
            "paper_seed_expansion",
            "targeted_ingest"
          ]
        },
        "objective": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "discipline_or_application": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "scope": {
          "$ref": "#/definitions/searchScope"
        },
        "local_coverage": {
          "$ref": "#/definitions/localCoverage"
        },
        "seed_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/seedArtifact"
          }
        },
        "query_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/queryLane"
          }
        },
        "source_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/sourceLane"
          }
        },
        "inclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "exclusion_criteria": {
          "$ref": "#/definitions/stringArray"
        },
        "candidate_policy": {
          "$ref": "#/definitions/candidatePolicy"
        },
        "breadth": {
          "type": "string",
          "enum": [
            "broad",
            "balanced",
            "quick"
          ]
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "pdf_policy": {
          "const": "three_route_public_identity_matched"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "url",
        "source_role",
        "reason",
        "facts"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "url": {
          "$ref": "#/definitions/httpUrl"
        },
        "source_role": {
          "type": "string",
          "enum": [
            "authoritative",
            "index",
            "secondary",
            "repository",
            "library_catalog",
            "public_web"
          ]
        },
        "query_lane": {
          "$ref": "#/definitions/queryLaneName"
        },
        "raw_title": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "identifier": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "reason": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "matchingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "source"
      ],
      "properties": {
        "field": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "value": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "isbn": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "pmid": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "arxiv": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strong_keys",
        "weak_key"
      ],
      "properties": {
        "strong_keys": {
          "$ref": "#/definitions/stringArray"
        },
        "weak_key": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "tier",
        "title",
        "alternate_titles",
        "creators_display",
        "year",
        "container",
        "original_language",
        "material_version",
        "identifiers",
        "identity",
        "discovery_sources",
        "matching_evidence",
        "duplicate_status",
        "missing_fields",
        "recommendation_reason"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "tier": {
          "type": "string",
          "enum": [
            "ready",
            "needs_curation",
            "lead_only"
          ]
        },
        "title": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "alternate_titles": {
          "$ref": "#/definitions/stringArray"
        },
        "creators_display": {
          "$ref": "#/definitions/stringArray"
        },
        "year": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "original_language": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "material_version": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "identifiers": {
          "$ref": "#/definitions/identifiers"
        },
        "identity": {
          "$ref": "#/definitions/candidateIdentity"
        },
        "discovery_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/sourceEvidence"
          }
        },
        "matching_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/matchingEvidence"
          }
        },
        "landing_url": {
          "$ref": "#/definitions/httpUrl"
        },
        "duplicate_status": {
          "type": "string",
          "enum": [
            "not_in_library",
            "possible_duplicate",
            "existing_exact",
            "version_related",
            "unknown"
          ]
        },
        "missing_fields": {
          "$ref": "#/definitions/stringArray"
        },
        "recommendation_reason": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "enum": [
                  "ready",
                  "needs_curation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "landing_url"
            ],
            "properties": {
              "landing_url": {
                "$ref": "#/definitions/httpUrl"
              }
            }
          }
        }
      ]
    },
    "queryAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "query",
        "source",
        "status",
        "result_count"
      ],
      "properties": {
        "lane": {
          "$ref": "#/definitions/queryLaneName"
        },
        "query": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "unavailable",
            "error"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "sourceFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reason"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "reason": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "fallback_used": {
          "type": "string"
        }
      }
    },
    "deduplicationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_count",
        "unique_candidate_count",
        "merged_record_count",
        "unresolved_conflict_count"
      ],
      "properties": {
        "source_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "merged_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_conflict_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_type",
        "description",
        "requested_lanes"
      ],
      "properties": {
        "gap_type": {
          "type": "string",
          "enum": [
            "topic",
            "language",
            "region",
            "period",
            "method",
            "literature_type",
            "source",
            "seed",
            "other"
          ]
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "requested_lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/queryLaneName"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "message": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "creatorByName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creatorType",
        "name"
      ],
      "properties": {
        "creatorType": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "creatorByParts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creatorType",
        "lastName"
      ],
      "properties": {
        "creatorType": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "creator": {
      "oneOf": [
        {
          "$ref": "#/definitions/creatorByName"
        },
        {
          "$ref": "#/definitions/creatorByParts"
        }
      ]
    },
    "originalTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "language",
        "script"
      ],
      "properties": {
        "value": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "language": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "script": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "alternateTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "role",
        "language",
        "script"
      ],
      "properties": {
        "value": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "role": {
          "type": "string",
          "enum": [
            "translated",
            "romanized",
            "abbreviated",
            "alternate_published"
          ]
        },
        "language": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "script": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "title"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "journal",
            "book",
            "proceedings",
            "conference",
            "university",
            "institution",
            "series",
            "repository"
          ]
        },
        "title": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "zoteroFields": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "title"
      ],
      "propertyNames": {
        "not": {
          "const": "DOI"
        }
      },
      "properties": {
        "title": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "extra": {
          "type": "string",
          "not": {
            "pattern": "(^|\\n)\\s*[Dd][Oo][Ii]\\s*:"
          }
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "resolvedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemType",
        "originalTitle",
        "alternateTitles",
        "language",
        "script",
        "creatorCompleteness",
        "fields",
        "creators",
        "identifiers",
        "containers",
        "landingUrl"
      ],
      "properties": {
        "itemType": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "originalTitle": {
          "$ref": "#/definitions/originalTitle"
        },
        "alternateTitles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/alternateTitle"
          }
        },
        "language": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "script": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "creatorCompleteness": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "fields": {
          "$ref": "#/definitions/zoteroFields"
        },
        "creators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/creator"
          }
        },
        "identifiers": {
          "$ref": "#/definitions/identifiers"
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/container"
          }
        },
        "landingUrl": {
          "$ref": "#/definitions/httpUrl"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "creatorCompleteness": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "creators": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creator"
                },
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "creators": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/creator"
                },
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "normalizedIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DOI",
            "ISBN",
            "PMID",
            "arXiv"
          ]
        },
        "value": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "metadataMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "direct_work",
        "material_conflict"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "identifier",
            "title"
          ]
        },
        "direct_work": {
          "const": true
        },
        "material_conflict": {
          "const": false
        },
        "normalized_identifier": {
          "$ref": "#/definitions/normalizedIdentifier"
        }
      }
    },
    "pdfAttemptFound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "source",
        "query_or_url",
        "status",
        "identity_match",
        "legal_source",
        "reachable",
        "pdf_url",
        "content_type"
      ],
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "authoritative_landing",
            "open_access",
            "web_search"
          ]
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "query_or_url": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "status": {
          "const": "found"
        },
        "identity_match": {
          "const": true
        },
        "legal_source": {
          "const": true
        },
        "reachable": {
          "const": true
        },
        "pdf_url": {
          "$ref": "#/definitions/httpUrl"
        },
        "content_type": {
          "type": "string",
          "pattern": "^application/pdf(?:$|;)"
        },
        "landing_url": {
          "$ref": "#/definitions/httpUrl"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pdfAttemptTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "source",
        "query_or_url",
        "status",
        "identity_match",
        "legal_source",
        "reachable"
      ],
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "authoritative_landing",
            "open_access",
            "web_search"
          ]
        },
