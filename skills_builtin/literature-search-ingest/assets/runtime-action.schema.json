    "recordPdfProbeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "candidate_id",
        "attempts"
      ],
      "properties": {
        "action": {
          "const": "record_pdf_probe"
        },
        "candidate_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/pdfAttempt"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "route"
                ],
                "properties": {
                  "route": {
                    "const": "authoritative_landing"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "route"
                ],
                "properties": {
                  "route": {
                    "const": "open_access"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "route"
                ],
                "properties": {
                  "route": {
                    "const": "web_search"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
