{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "ingested_references",
        "missing_pdf_references"
      ],
      "properties": {
        "kind": { "const": "literature_search_ingest" },
        "query": { "type": "string" },
        "search_mode": {
          "type": "string",
          "enum": [
            "topic_expansion",
            "paper_seed_expansion",
            "targeted_ingest"
          ]
        },
        "ingested_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "title", "status"],
            "properties": {
              "index": { "type": "number" },
              "title": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["created", "existing"]
              },
              "itemRef": { "type": "object" },
              "doi": { "type": "string" },
              "arxiv": { "type": "string" },
              "pmid": { "type": "string" },
              "isbn": { "type": "string" },
              "landingUrl": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "missing_pdf_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "title"],
            "properties": {
              "index": { "type": "number" },
              "title": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["created", "existing"]
              },
              "itemRef": { "type": "object" },
              "doi": { "type": "string" },
              "arxiv": { "type": "string" },
              "pmid": { "type": "string" },
              "isbn": { "type": "string" },
              "landingUrl": { "type": "string" },
              "manualSearchLinks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reason": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "ingest_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "title", "error"],
            "properties": {
              "index": { "type": "number" },
              "title": { "type": "string" },
              "error": { "type": "object" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["kind", "status", "reason", "message"],
      "properties": {
        "kind": { "const": "literature_search_ingest_canceled" },
        "status": { "const": "canceled" },
        "reason": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  ]
}
