{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Literature Search Ingest final output",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/completedOutput" },
    { "$ref": "#/$defs/canceledOutput" }
  ],
  "$defs": {
    "itemRef": {
      "type": "object",
      "required": ["libraryId", "key"],
      "properties": {
        "libraryId": { "type": "integer", "minimum": 1 },
        "key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "successfulOutcome": {
      "type": "object",
      "required": [
        "title",
        "ingestStatus",
        "itemRef",
        "pdfStatus",
        "needsCuration"
      ],
      "properties": {
        "title": { "type": "string" },
        "ingestStatus": {
          "type": "string",
          "enum": ["created", "existing"]
        },
        "itemRef": { "$ref": "#/$defs/itemRef" },
        "pdfStatus": {
          "type": "string",
          "enum": ["attached", "missing", "skipped", "failed"]
        },
        "needsCuration": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "unsuccessfulOutcome": {
      "type": "object",
      "required": ["title", "ingestStatus"],
      "properties": {
        "title": { "type": "string" },
        "ingestStatus": {
          "type": "string",
          "enum": ["failed", "not_attempted"]
        }
      },
      "additionalProperties": false
    },
    "completedOutput": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "summary",
        "outcomes",
        "searchLedgerPath"
      ],
      "properties": {
        "__SKILL_DONE__": { "type": "boolean" },
        "kind": { "const": "literature_search_ingest" },
        "status": { "const": "completed" },
        "summary": {
          "type": "object",
          "required": [
            "discovered",
            "selected",
            "created",
            "existing",
            "failed",
            "notAttempted"
          ],
          "properties": {
            "discovered": { "type": "integer", "minimum": 0 },
            "selected": { "type": "integer", "minimum": 0 },
            "created": { "type": "integer", "minimum": 0 },
            "existing": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "notAttempted": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "outcomes": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/successfulOutcome" },
              { "$ref": "#/$defs/unsuccessfulOutcome" }
            ]
          }
        },
        "searchLedgerPath": {
          "const": "result/search-ledger.json",
          "x-type": "artifact",
          "x-role": "search-ledger"
        }
      },
      "additionalProperties": false
    },
    "canceledOutput": {
      "type": "object",
      "required": ["kind", "status", "reason", "message"],
      "properties": {
        "__SKILL_DONE__": { "type": "boolean" },
        "kind": { "const": "literature_search_ingest_canceled" },
        "status": { "const": "canceled" },
        "reason": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
