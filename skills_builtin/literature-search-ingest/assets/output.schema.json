{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "searchSummary",
        "outcomes",
        "searchLedgerPath"
      ],
      "properties": {
        "kind": {
          "const": "literature_search_ingest"
        },
        "status": {
          "const": "completed"
        },
        "query": {
          "type": "string"
        },
        "search_mode": {
          "type": "string",
          "enum": [
            "guided",
            "topic_expansion",
            "paper_seed_expansion",
            "targeted_ingest"
          ]
        },
        "searchSummary": {
          "type": "object",
          "required": [
            "breadth",
            "languages",
            "queryLaneCount",
            "sourceLaneCount",
            "uniqueCandidateCount",
            "selectedCount",
            "stopReason"
          ],
          "properties": {
            "breadth": {
              "type": "string",
              "enum": [
                "broad",
                "balanced",
                "quick"
              ]
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "queryLaneCount": {
              "type": "integer",
              "minimum": 0
            },
            "sourceLaneCount": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueCandidateCount": {
              "type": "integer",
              "minimum": 0
            },
            "selectedCount": {
              "type": "integer",
              "minimum": 0
            },
            "stopReason": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidateId",
              "title",
              "candidateTier",
              "discoverySources",
              "decision",
              "ingestStatus",
              "pdfStatus",
              "needsCuration"
            ],
            "properties": {
              "candidateId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "candidateTier": {
                "type": "string",
                "enum": [
                  "ready",
                  "needs_curation",
                  "lead_only"
                ]
              },
              "discoverySources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "queryLane"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "queryLane": {
                      "type": "string",
                      "enum": [
                        "core",
                        "multilingual",
                        "seed",
                        "gap"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "identifiers": {
                "type": "object",
                "properties": {
                  "doi": { "type": "string" },
                  "arxiv": { "type": "string" },
                  "pmid": { "type": "string" },
                  "isbn": { "type": "string" }
                },
                "additionalProperties": false
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected",
                  "not_selected",
                  "unresolved"
                ]
              },
              "ingestStatus": {
                "type": "string",
                "enum": [
                  "created",
                  "existing",
                  "not_attempted",
                  "failed"
                ]
              },
              "pdfStatus": {
                "type": "string",
                "enum": [
                  "attached",
                  "missing",
                  "skipped",
                  "failed"
                ]
              },
              "needsCuration": {
                "type": "boolean"
              },
              "itemRef": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer", "minimum": 1 },
                  "key": { "type": "string" },
                  "libraryId": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": true
              },
              "landingUrl": {
                "type": "string"
              },
              "manualSearchLinks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasonCode": {
                "type": "string"
              },
              "error": {}
            },
            "additionalProperties": true
          }
        },
        "searchLedgerPath": {
          "type": "string",
          "x-type": "artifact",
          "x-role": "search-ledger"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "reason",
        "message"
      ],
      "properties": {
        "kind": {
          "const": "literature_search_ingest_canceled"
        },
        "status": {
          "const": "canceled"
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  ]
}
