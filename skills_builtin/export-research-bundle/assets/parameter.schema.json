{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["paperTitle", "researchContent"],
  "properties": {
    "paperTitle": { "type": "string", "minLength": 1 },
    "articleType": { "type": "string", "default": "original research" },
    "researchContent": { "type": "string", "minLength": 1 },
    "maxTopics": { "type": "integer", "minimum": 0, "maximum": 10, "default": 5 },
    "maxCorePapers": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
    "maxRelatedPapers": { "type": "integer", "minimum": 1, "maximum": 200, "default": 80 }
  },
  "additionalProperties": false
}
