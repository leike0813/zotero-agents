{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "intent", "limits", "query_plan", "topics", "papers", "diagnostics"],
  "properties": {
    "schema_id": { "const": "research_bundle.selection" },
    "schema_version": { "const": "2.0.0" },
    "intent": { "type": "object" },
    "limits": { "type": "object" },
    "query_plan": { "type": "object" },
    "topics": { "type": "array" },
    "papers": { "type": "array" },
    "diagnostics": { "type": "array" }
  }
}
