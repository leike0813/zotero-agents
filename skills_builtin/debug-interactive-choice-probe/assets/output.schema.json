{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Debug Interactive Choice Probe Result",
  "type": "object",
  "required": [
    "kind",
    "ok",
    "accepted_any_reply",
    "message",
    "warnings"
  ],
  "properties": {
    "kind": { "const": "debug_interactive_choice_probe_result" },
    "ok": { "type": "boolean", "description": "Whether the interactive choice probe passed." },
    "accepted_any_reply": { "type": "boolean", "description": "Whether any reply was accepted by the probe." },
    "message": { "type": "string", "description": "Human-readable diagnostic message." },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-fatal warning messages. Empty array when none."
    }
  },
  "additionalProperties": true
}
