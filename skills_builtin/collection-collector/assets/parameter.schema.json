{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["collection", "collectionScope"],
  "properties": {
    "collection": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[A-Za-z0-9]+$"
    },
    "collectionScope": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
