{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "literature-metadata-search-input",
  "title": "Literature Metadata Search Input",
  "description": "Input payload for resolving metadata for one bibliographic source record.",
  "type": "object",
  "required": ["parent"],
  "properties": {
    "parent": {
      "type": ["object", "null"],
      "x-input-source": "inline",
      "description": "Source bibliographic record snapshot. Named parent for workflow compatibility, but usable as a generic literature record.",
      "properties": {
        "itemType": {
          "type": "string",
          "description": "Original record type. This is context only and must not be emitted as an update field."
        },
        "title": {
          "type": "string",
          "description": "Record title."
        },
        "DOI": {
          "type": "string",
          "description": "Record DOI, if known."
        },
        "ISBN": {
          "type": "string",
          "description": "Record ISBN, if known."
        },
        "fields": {
          "type": "object",
          "description": "Known scalar bibliographic fields.",
          "additionalProperties": true
        },
        "creators": {
          "type": "array",
          "description": "Known creators from the source record.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": ["object", "null"],
      "x-input-source": "inline",
      "description": "Optional upstream-selected identifier.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["DOI", "ISBN", "PMID", "arXiv"]
        },
        "value": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        }
      },
      "required": ["type", "value"],
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "array",
      "x-input-source": "inline",
      "description": "Optional prior lookup diagnostics from the caller.",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
