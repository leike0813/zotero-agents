{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "literature-metadata-search-output",
  "title": "Literature Metadata Search Output",
  "description": "Canonical metadata curation result consumed by workflows and apply handlers.",
  "type": "object",
  "required": [
    "kind",
    "status",
    "source",
    "metadata",
    "evidence",
    "warnings"
  ],
  "properties": {
    "kind": {
      "const": "literature_metadata_curation"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "verified_no_change", "skipped", "failed"]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": ["fields", "creators"],
      "properties": {
        "itemType": {
          "type": "string",
          "description": "Optional Zotero bibliographic item type name for a high-confidence correction."
        },
        "originalTitle": {
          "type": "object",
          "description": "Authoritative original-script title used as the direct-work identity.",
          "required": ["value"],
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "language": { "type": "string" },
            "script": { "type": "string" }
          },
          "additionalProperties": false
        },
        "alternateTitles": {
          "type": "array",
          "description": "Translated, romanized, abbreviated, or other alternate titles retained for matching only.",
          "items": {
            "type": "object",
            "required": ["value", "role"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "role": {
                "type": "string",
                "enum": ["translated", "romanized", "abbreviated", "alternate"]
              },
              "language": { "type": "string" },
              "script": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "description": "Language of the direct work when evidenced."
        },
        "script": {
          "type": "string",
          "description": "Script of the direct work's authoritative title when evidenced."
        },
        "containers": {
          "type": "array",
          "description": "Semantically typed containers retained separately from the direct-work title.",
          "items": {
            "type": "object",
            "required": ["role", "title"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["journal", "book", "proceedings", "conference", "institution", "series"]
              },
              "title": { "type": "string", "minLength": 1 },
              "language": { "type": "string" },
              "script": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "creatorCompleteness": {
          "type": "string",
          "enum": ["complete", "incomplete", "unknown"],
          "description": "Whether the creator list is verified complete. Only complete lists are applied."
        },
        "fields": {
          "type": "object",
          "description": "Zotero-compatible scalar metadata fields. Unsupported mutation surfaces are not allowed.",
          "properties": {
            "title": { "type": ["string", "number", "boolean"] },
            "shortTitle": { "type": ["string", "number", "boolean"] },
            "DOI": { "type": ["string", "number", "boolean"] },
            "ISBN": { "type": ["string", "number", "boolean"] },
            "ISSN": { "type": ["string", "number", "boolean"] },
            "url": { "type": ["string", "number", "boolean"] },
            "abstractNote": { "type": ["string", "number", "boolean"] },
            "date": { "type": ["string", "number", "boolean"] },
            "publicationTitle": { "type": ["string", "number", "boolean"] },
            "journalAbbreviation": { "type": ["string", "number", "boolean"] },
            "volume": { "type": ["string", "number", "boolean"] },
            "issue": { "type": ["string", "number", "boolean"] },
            "pages": { "type": ["string", "number", "boolean"] },
            "language": { "type": ["string", "number", "boolean"] },
            "libraryCatalog": { "type": ["string", "number", "boolean"] },
            "place": { "type": ["string", "number", "boolean"] },
            "publisher": { "type": ["string", "number", "boolean"] },
            "edition": { "type": ["string", "number", "boolean"] },
            "series": { "type": ["string", "number", "boolean"] },
            "seriesTitle": { "type": ["string", "number", "boolean"] },
            "seriesNumber": { "type": ["string", "number", "boolean"] },
            "numberOfVolumes": { "type": ["string", "number", "boolean"] },
            "numPages": { "type": ["string", "number", "boolean"] },
            "bookTitle": { "type": ["string", "number", "boolean"] },
            "conferenceName": { "type": ["string", "number", "boolean"] },
            "proceedingsTitle": {
              "type": ["string", "number", "boolean"]
            },
            "university": { "type": ["string", "number", "boolean"] },
            "thesisType": { "type": ["string", "number", "boolean"] },
            "reportType": { "type": ["string", "number", "boolean"] },
            "institution": { "type": ["string", "number", "boolean"] },
            "archive": { "type": ["string", "number", "boolean"] },
            "archiveLocation": {
              "type": ["string", "number", "boolean"]
            },
            "callNumber": { "type": ["string", "number", "boolean"] },
            "rights": { "type": ["string", "number", "boolean"] },
            "accessDate": { "type": ["string", "number", "boolean"] }
            ,"extra": { "type": ["string", "number", "boolean"] }
          },
          "additionalProperties": false
        },
        "creators": {
          "type": "array",
          "description": "Complete evidence-backed creator replacement list. Use an empty array when no complete supported replacement should be applied.",
          "items": {
            "type": "object",
            "required": ["creatorType"],
            "properties": {
              "creatorType": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "name": { "type": "string" }
            },
            "anyOf": [
              { "required": ["name"] },
              { "required": ["firstName"] },
              { "required": ["lastName"] }
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string" },
          "url": { "type": "string" },
          "identifier": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
