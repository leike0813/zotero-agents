{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "not": {
    "anyOf": [{ "required": ["markdown"] }, { "required": ["markdown_path"] }]
  },
  "definitions": {
    "topic-domain.NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "topic-domain.String": { "type": "string", "maxLength": 65536 },
    "topic-domain.Strings": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/definitions/topic-domain.String" }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "language",
        "topic_definition",
        "artifact_manifest_path"
      ],
      "properties": {
        "kind": { "const": "topic_synthesis" },
        "operation": { "const": "create" },
        "language": { "type": "string", "minLength": 1 },
        "topic_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "title": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "name": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "definition": { "$ref": "#/definitions/topic-domain.String" },
            "scope": { "$ref": "#/definitions/topic-domain.String" },
            "discipline": { "$ref": "#/definitions/topic-domain.String" },
            "research_field": { "$ref": "#/definitions/topic-domain.String" },
            "research_area": { "$ref": "#/definitions/topic-domain.String" },
            "scope_boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["include", "exclude"],
              "properties": {
                "include": { "$ref": "#/definitions/topic-domain.Strings" },
                "exclude": { "$ref": "#/definitions/topic-domain.Strings" },
                "notes": { "$ref": "#/definitions/topic-domain.String" }
              }
            },
            "aliases": { "$ref": "#/definitions/topic-domain.Strings" },
            "scope_include": { "$ref": "#/definitions/topic-domain.Strings" },
            "scope_exclude": { "$ref": "#/definitions/topic-domain.Strings" }
          }
        },
        "artifact_manifest_path": {
          "type": "string",
          "minLength": 1,
          "x-type": "artifact-manifest",
          "x-role": "artifact-manifest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "language",
        "topic_definition",
        "artifact_manifest_path",
        "base_hashes"
      ],
      "properties": {
        "kind": { "const": "topic_synthesis" },
        "operation": { "const": "update_full" },
        "language": { "type": "string", "minLength": 1 },
        "topic_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "title": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "name": { "$ref": "#/definitions/topic-domain.NonEmptyString" },
            "definition": { "$ref": "#/definitions/topic-domain.String" },
            "scope": { "$ref": "#/definitions/topic-domain.String" },
            "discipline": { "$ref": "#/definitions/topic-domain.String" },
            "research_field": { "$ref": "#/definitions/topic-domain.String" },
            "research_area": { "$ref": "#/definitions/topic-domain.String" },
            "scope_boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["include", "exclude"],
              "properties": {
                "include": { "$ref": "#/definitions/topic-domain.Strings" },
                "exclude": { "$ref": "#/definitions/topic-domain.Strings" },
                "notes": { "$ref": "#/definitions/topic-domain.String" }
              }
            },
            "aliases": { "$ref": "#/definitions/topic-domain.Strings" },
            "scope_include": { "$ref": "#/definitions/topic-domain.Strings" },
            "scope_exclude": { "$ref": "#/definitions/topic-domain.Strings" }
          }
        },
        "base_hashes": {
          "type": "object",
          "maxProperties": 256,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false
        },
        "artifact_manifest_path": {
          "type": "string",
          "minLength": 1,
          "x-type": "artifact-manifest",
          "x-role": "artifact-manifest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "reason", "message"],
      "properties": {
        "kind": { "const": "topic_synthesis_canceled" },
        "status": { "const": "canceled" },
        "reason": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "duplicate_topic_id": { "type": "string" },
        "topic_seed": { "type": "string" },
        "topic_id": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  ]
}
