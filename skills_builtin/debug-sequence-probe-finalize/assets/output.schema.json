{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Debug Sequence Probe Result",
  "type": "object",
  "required": [
    "kind",
    "probe_id",
    "status",
    "checks",
    "diagnostics"
  ],
  "properties": {
    "kind": { "const": "debug_sequence_probe_result" },
    "probe_id": { "type": "string", "minLength": 1, "description": "Identifier for this probe run." },
    "status": { "enum": ["ok", "failed"], "description": "Execution status of this run." },
    "public_marker": { "type": "string" },
    "secret_marker": { "type": "string" },
    "sentinel_path": { "type": "string" },
    "workspace_cwd": { "type": "string" },
    "checks": { "type": "array", "items": { "type": "object" }, "description": "Array of validation check results." },
    "diagnostics": { "type": "array", "items": { "type": "object" }, "description": "Diagnostic information. May be an empty array." }
  },
  "additionalProperties": true
}
