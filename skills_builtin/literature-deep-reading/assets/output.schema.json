{
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "diagnostics_path",
        "final_html_available",
        "html_path",
        "artifact_manifest_path",
        "warnings",
        "error"
      ],
      "properties": {
        "kind": { "const": "literature_deep_reading_finalized" },
        "status": { "const": "completed" },
        "diagnostics_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the diagnostics artifact file.",
          "x-type": "artifact",
          "x-role": "diagnostics"
        },
        "final_html_available": { "const": true },
        "html_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the final deep-reading HTML output.",
          "x-type": "artifact",
          "x-role": "deep-reading-html"
        },
        "artifact_manifest_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the artifact manifest file.",
          "x-type": "artifact-manifest",
          "x-role": "artifact-manifest"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal warning messages. Empty array when none."
        },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "description": "Error details object. Empty object `{}` on success."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "diagnostics_path",
        "final_html_available",
        "warnings",
        "error"
      ],
      "properties": {
        "kind": { "const": "literature_deep_reading_error" },
        "status": { "const": "failed" },
        "db_path": { "type": "string" },
        "views": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "diagnostics_path": { "type": "string", "description": "Path to the diagnostics artifact file. May be empty." },
        "final_html_available": { "type": "boolean", "description": "Whether the final HTML output is available." },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal warning messages. Empty array when none."
        },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "description": "Error details object describing the failure."
        }
      }
    }
  ]
}
