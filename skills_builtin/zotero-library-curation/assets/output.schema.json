{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zotero-library-task.result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "summary"],
  "properties": {
    "schema": { "const": "zotero-library-task.result.v1" },
    "status": { "type": "string", "enum": ["completed", "canceled", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": {},
          "locator": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "x-type": "artifact" },
          "role": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
