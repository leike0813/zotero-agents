{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "operation", "base_graph_hash", "library_index_hash", "topic_actions", "relation_proposals", "recommended_updates"],
  "properties": {
    "kind": { "const": "topic_plan" },
    "operation": { "const": "reconcile" },
    "base_graph_hash": { "type": "string", "minLength": 1 },
    "library_index_hash": { "type": "string", "minLength": 1 },
    "coverage_manifest_path": {
      "type": "string",
      "minLength": 1,
      "x-type": "artifact-manifest",
      "x-role": "coverage-manifest"
    },
    "topic_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "topic_id"],
        "properties": {
          "action": { "enum": ["create", "update", "mark_stale", "reactivate"] },
          "topic_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "definition": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "include": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "exclude": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          },
          "resolver": { "type": "object", "minProperties": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "basis": { "type": "array" },
          "provenance": { "type": "array" }
        }
      }
    },
    "relation_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_topic_id", "target_topic_id", "relation", "provenance", "evidence_refs"],
        "properties": {
          "source_topic_id": { "type": "string", "minLength": 1 },
          "target_topic_id": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["broader_than", "related_to", "overlaps_with", "contrasts_with"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "provenance": { "type": "array" },
          "evidence_refs": { "type": "array" }
        }
      }
    },
    "recommended_updates": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
