{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "operation",
    "base_graph_hash",
    "library_index_hash",
    "topic_actions",
    "relation_proposals",
    "recommended_updates"
  ],
  "properties": {
    "kind": { "const": "topic_plan" },
    "operation": { "const": "reconcile" },
    "base_graph_hash": { "type": "string" },
    "library_index_hash": { "type": "string" },
    "topic_actions": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/definitions/client-topic-workbench.TopicPlanAction"
      }
    },
    "relation_proposals": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/client-topic-workbench.TopicPlanRelationProposal"
      }
    },
    "coverage_manifest_path": {
      "type": "string",
      "x-type": "artifact-manifest",
      "x-role": "coverage-manifest"
    },
    "recommended_updates": {
      "$ref": "#/definitions/client-topic-workbench.Strings"
    }
  },
  "definitions": {
    "client-topic-workbench.TopicPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "topic_id"],
      "properties": {
        "action": { "enum": ["create", "update", "mark_stale", "reactivate"] },
        "topic_id": { "$ref": "#/definitions/client-topic-workbench.String" },
        "title": { "type": "string", "maxLength": 16384 },
        "definition": { "type": "string", "maxLength": 65536 },
        "aliases": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "scope": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningScope"
        },
        "resolver": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningSelector"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "basis": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidenceList"
        },
        "provenance": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidenceList"
        }
      }
    },
    "client-topic-workbench.String": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "client-topic-workbench.Strings": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/definitions/client-topic-workbench.String" }
    },
    "client-topic-workbench.TopicPlanningScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "exclude": { "$ref": "#/definitions/client-topic-workbench.Strings" }
      }
    },
    "client-topic-workbench.TopicPlanningSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_refs": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "collection_key": {
          "$ref": "#/definitions/client-topic-workbench.Strings"
        },
        "tag": { "$ref": "#/definitions/client-topic-workbench.ResolverTag" },
        "combine": { "enum": ["union", "intersection"] }
      }
    },
    "client-topic-workbench.ResolverTag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "and": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "or": { "$ref": "#/definitions/client-topic-workbench.Strings" },
        "not": { "$ref": "#/definitions/client-topic-workbench.Strings" }
      }
    },
    "client-topic-workbench.TopicPlanningEvidenceList": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidence"
      }
    },
    "client-topic-workbench.TopicPlanningEvidence": {
      "oneOf": [
        { "$ref": "#/definitions/client-topic-workbench.String" },
        {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidenceObject"
        }
      ]
    },
    "client-topic-workbench.TopicPlanningEvidenceObject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "producer": { "$ref": "#/definitions/client-topic-workbench.String" },
        "source": { "$ref": "#/definitions/client-topic-workbench.String" },
        "kind": { "$ref": "#/definitions/client-topic-workbench.String" },
        "ref": { "$ref": "#/definitions/client-topic-workbench.String" },
        "hash": { "$ref": "#/definitions/client-topic-workbench.String" },
        "reason": { "type": "string", "maxLength": 65536 },
        "path": { "type": "string", "maxLength": 4096 }
      }
    },
    "client-topic-workbench.TopicPlanRelationProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_topic_id", "target_topic_id", "relation"],
      "properties": {
        "source_topic_id": {
          "$ref": "#/definitions/client-topic-workbench.String"
        },
        "target_topic_id": {
          "$ref": "#/definitions/client-topic-workbench.String"
        },
        "relation": {
          "enum": [
            "broader_than",
            "related_to",
            "overlaps_with",
            "contrasts_with"
          ]
        },
        "confidence": {
          "$ref": "#/definitions/client-topic-workbench.NullableConfidence"
        },
        "provenance": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidenceList"
        },
        "evidence_refs": {
          "$ref": "#/definitions/client-topic-workbench.TopicPlanningEvidenceList"
        }
      }
    },
    "client-topic-workbench.NullableConfidence": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    }
  }
}
