{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Debug Apply Result Probe Result",
  "type": "object",
  "required": [
    "kind",
    "workflow_id",
    "step_id",
    "run_key",
    "apply_mode",
    "tag",
    "message"
  ],
  "properties": {
    "kind": { "const": "debug_apply_contract_result" },
    "workflow_id": { "type": "string", "minLength": 1, "description": "Workflow identifier for this probe run." },
    "step_id": { "type": "string", "minLength": 1, "description": "Current step identifier within the workflow." },
    "run_key": { "type": "string", "minLength": 1, "description": "Unique run key for this workflow execution." },
    "apply_mode": { "const": "result" },
    "tag": { "type": "string", "minLength": 1, "description": "Tag value associated with this contract result." },
    "message": { "type": "string", "description": "Human-readable diagnostic message." }
  },
  "additionalProperties": true
}

