{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manuscript Literature Framing Result",
  "type": "object",
  "additionalProperties": true,
  "oneOf": [
    {
      "title": "Completed manuscript literature framing",
      "type": "object",
      "required": [
        "kind",
        "title",
        "language",
        "artifact_manifest_path"
      ],
      "properties": {
        "kind": { "const": "writing.manuscript_literature_framing" },
         "title": { "type": "string", "minLength": 1, "description": "Title of the manuscript being framed." },
         "language": { "type": "string", "minLength": 1, "description": "Target output language code (e.g., zh-CN, en-US)." },
         "topic_ids": {
           "type": "array",
           "items": { "type": "string" }
         },
         "artifact_manifest_path": {
           "type": "string",
           "minLength": 1,
           "description": "Path to the artifact manifest file.",
           "x-type": "artifact-manifest",
           "x-role": "artifact-manifest"
         }
      }
    },
    {
      "title": "Canceled manuscript literature framing",
      "type": "object",
      "required": ["kind", "status", "reason", "message"],
      "properties": {
        "kind": { "const": "manuscript_literature_framing_canceled" },
        "status": { "const": "canceled" },
         "reason": { "type": "string", "minLength": 1, "description": "Machine-readable reason code explaining the cancellation." },
         "message": { "type": "string", "minLength": 1, "description": "Human-readable explanation message." },
        "paperTitle": { "type": "string" }
      }
    }
  ]
}
