{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/schemas/host-bridge-capabilities.v2.schema.json",
  "title": "Host Bridge executable capability contracts v2",
  "type": "object",
  "required": ["schema", "protocol", "capabilities"],
  "properties": {
    "schema": {
      "const": "host-bridge.capabilities.v2"
    },
    "protocol": {
      "const": "host-bridge.v2"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonSchema": {
      "type": "object"
    },
    "capability": {
      "type": "object",
      "required": [
        "category",
        "summary",
        "inputSchema",
        "outputSchema",
        "effect",
        "approval",
        "exposure"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "outputSchema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "effect": {
          "enum": ["read", "state-change"]
        },
        "approval": {
          "enum": ["none", "zotero-ui-required"]
        },
        "exposure": {
          "type": "object",
          "required": [
            "public",
            "debugOnly",
            "dangerous",
            "cacheView",
            "rawOnly",
            "mcpMirror",
            "responseSizing"
          ],
          "properties": {
            "public": {
              "type": "boolean"
            },
            "debugOnly": {
              "type": "boolean"
            },
            "dangerous": {
              "type": "boolean"
            },
            "cacheView": {
              "type": "boolean"
            },
            "rawOnly": {
              "type": "boolean"
            },
            "mcpMirror": {
              "type": "boolean"
            },
            "responseSizing": {
              "enum": [
                "paged",
                "limit-bounded",
                "selector-bounded",
                "file-output",
                "bounded-diagnostic",
                "unclassified"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
