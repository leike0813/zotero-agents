{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/schemas/host-bridge.semantic-guidance.v2.schema.json",
  "title": "Host Bridge semantic guidance v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domains", "journeys"],
  "properties": {
    "schema": { "const": "host-bridge.semantic-guidance.v2" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "commands", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
