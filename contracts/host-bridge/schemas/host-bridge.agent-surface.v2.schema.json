{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/schemas/host-bridge.agent-surface.v2.schema.json",
  "title": "Host Bridge Agent Surface v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "cliSchema",
    "commandCatalogChecksum",
    "commands"
  ],
  "properties": {
    "schema": { "const": "host-bridge.agent-surface.v2" },
    "protocol": { "const": "host-bridge.v1" },
    "cliSchema": { "const": "zotero-bridge.cli.v2" },
    "commandCatalogChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "argv",
          "summary",
          "category",
          "danger",
          "invocationSchema",
          "argvBindings",
          "payloadSchema",
          "resultSchema",
          "pagination",
          "effects",
          "approvalContract",
          "handleTransitions",
          "recovery",
          "targets",
          "intents",
          "guidance",
          "hiddenFromIntentSearch"
        ],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "summary": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["read", "navigation", "write", "maintenance", "debug"]
          },
          "danger": { "enum": ["none", "review", "high"] },
          "invocationSchema": { "type": "object" },
          "argvBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "property",
                "kind",
                "token",
                "takesValue",
                "required",
                "valueNames"
              ],
              "properties": {
                "property": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["option", "positional"] },
                "token": { "type": "string", "minLength": 1 },
                "position": { "type": "integer", "minimum": 1 },
                "shortToken": { "type": "string", "pattern": "^-" },
                "takesValue": { "type": "boolean" },
                "required": { "type": "boolean" },
                "valueNames": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "payloadSchema": { "type": "object" },
          "resultSchema": { "type": "object" },
          "pagination": { "enum": ["none", "cursor", "file"] },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "stateChanged", "description"],
              "properties": {
                "kind": {
                  "enum": [
                    "none",
                    "ui-navigation",
                    "ephemeral-file",
                    "workflow-control",
                    "zotero-library",
                    "product-store",
                    "cache-maintenance",
                    "graph-metrics-maintenance",
                    "debug-repair"
                  ]
                },
                "stateChanged": { "type": "boolean" },
                "description": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "approvalContract": {
            "type": "object",
            "required": ["kind", "timing", "scope"],
            "properties": {
              "kind": { "enum": ["none", "zotero-ui-required", "conditional"] },
              "timing": {
                "enum": [
                  "none",
                  "before-command",
                  "during-execution",
                  "apply-back"
                ]
              },
              "scope": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "handleTransitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "handle",
                "direction",
                "required",
                "condition",
                "lifetime"
              ],
              "properties": {
                "handle": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["consume", "produce"] },
                "required": { "type": "boolean" },
                "condition": { "type": "string", "minLength": 1 },
                "lifetime": {
                  "enum": [
                    "caller-owned",
                    "response",
                    "short-lived",
                    "one-shot"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "recovery": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["when", "stateCheck", "requiresHandles", "action"],
              "properties": {
                "when": { "type": "string", "minLength": 1 },
                "stateCheck": {
                  "enum": ["none", "command-result", "caller-held-handle"]
                },
                "requiresHandles": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "action": { "type": "string", "minLength": 1 },
                "nextCommand": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "targets": {
            "type": "array",
            "items": { "type": "object", "required": ["kind", "target"] },
            "minItems": 1
          },
          "intents": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          },
          "guidance": {
            "type": "object",
            "required": [
              "family",
              "domain",
              "operation",
              "purpose",
              "commandSpecific",
              "intents",
              "useWhen",
              "avoidWhen",
              "distinguishFrom",
              "preconditions",
              "evidence",
              "failureChecks",
              "followups",
              "example"
            ],
            "properties": {
              "commandSpecific": { "const": true }
            }
          },
          "hiddenFromIntentSearch": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
