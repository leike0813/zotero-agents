{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.dev/schemas/host-bridge.release-set.v3.schema.json",
  "title": "Host Bridge Release Set v3",
  "type": "object",
  "required": [
    "schema",
    "releaseSetId",
    "status",
    "payloadDigest",
    "source",
    "protocol",
    "cliSchema",
    "cli",
    "surfaces"
  ],
  "properties": {
    "schema": {
      "const": "host-bridge.release-set.v3"
    },
    "releaseSetId": {
      "type": "string",
      "pattern": "^hbrs-[a-f0-9]{24}$"
    },
    "status": {
      "enum": ["planned", "complete"]
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "const": "host-bridge.v1"
    },
    "cliSchema": {
      "const": "zotero-bridge.cli.v4"
    },
    "cli": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "buildFingerprint",
        "binariesBuildFingerprint",
        "commandCatalogChecksum",
        "binaryAggregateSha256",
        "binaries",
        "identity",
        "prebuild"
      ],
      "properties": {
        "schema": {
          "const": "zotero-bridge-cli-release.v1"
        },
        "version": {
          "type": "string"
        },
        "buildFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binariesBuildFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commandCatalogChecksum": {
          "type": "string",
          "minLength": 1
        },
        "binaryAggregateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binaries": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["platform", "binary", "sha256", "bytes"],
            "properties": {
              "platform": {
                "enum": [
                  "win32-x64",
                  "darwin-x64",
                  "darwin-arm64",
                  "linux-x86",
                  "linux-x64",
                  "linux-arm",
                  "linux-arm64"
                ]
              },
              "binary": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "identity": {
          "$ref": "#/$defs/cliIdentity"
        },
        "prebuild": {
          "type": "object",
          "required": [
            "verified",
            "branch",
            "buildFingerprint",
            "binaryAggregateSha256"
          ],
          "properties": {
            "verified": {
              "const": true
            },
            "branch": {
              "const": "host-bridge-cli-prebuilds"
            },
            "buildFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binaryAggregateSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "object",
      "required": ["cliBundle", "libraryAgent", "librarianProfile"],
      "properties": {
        "cliBundle": {
          "$ref": "#/$defs/surface"
        },
        "libraryAgent": {
          "$ref": "#/$defs/surface"
        },
        "librarianProfile": {
          "$ref": "#/$defs/surface"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "cliIdentity": {
      "type": "object",
      "required": [
        "schema",
        "protocol",
        "cliSchema",
        "version",
        "buildFingerprint",
        "commandCatalogChecksum"
      ],
      "properties": {
        "schema": {
          "const": "host-bridge.surface-identity.v5"
        },
        "protocol": {
          "const": "host-bridge.v1"
        },
        "cliSchema": {
          "const": "zotero-bridge.cli.v4"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "buildFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commandCatalogChecksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": [
        "version",
        "contentDigest",
        "repository",
        "immutableTag",
        "cliIdentity"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository": {
          "type": "string"
        },
        "mutableRef": {
          "type": "string"
        },
        "immutableTag": {
          "type": "string"
        },
        "cliIdentity": {
          "$ref": "#/$defs/cliIdentity"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
