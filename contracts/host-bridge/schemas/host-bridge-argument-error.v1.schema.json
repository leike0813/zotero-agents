{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/schemas/host-bridge-argument-error.v1.schema.json",
  "title": "Host Bridge structured argument error details v1",
  "type": "object",
  "required": ["schema", "phase", "violations", "truncated"],
  "properties": {
    "schema": {
      "const": "host-bridge.argument-error.v1"
    },
    "phase": {
      "enum": [
        "argv",
        "json_source",
        "json_syntax",
        "command_input",
        "capability_input",
        "payload_contract",
        "command_result"
      ]
    },
    "command": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "argumentId": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "violations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "schemaPath": {
            "type": "string"
          },
          "expected": {},
          "actualType": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "conflictsWith": {
            "type": "string"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "column": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
