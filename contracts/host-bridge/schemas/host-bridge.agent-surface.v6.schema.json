{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-agents.local/schemas/host-bridge.agent-surface.v6.schema.json",
  "title": "Zotero Bridge Agent Surface v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "cliSchema",
    "commandCatalogChecksum",
    "globalOptions",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "host-bridge.agent-surface.v6"
    },
    "protocol": {
      "const": "host-bridge.v2"
    },
    "cliSchema": {
      "const": "zotero-bridge.cli.v5"
    },
    "commandCatalogChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "globalOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "token",
          "takesValue",
          "required",
          "global",
          "help",
          "valueNames",
          "possibleValues",
          "conflictsWith",
          "repeatable",
          "aliases",
          "defaultValues"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["option", "positional"]
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "shortToken": {
            "type": "string",
            "pattern": "^-"
          },
          "takesValue": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "global": {
            "type": "boolean"
          },
          "help": {
            "type": "string",
            "minLength": 1
          },
          "longHelp": {
            "type": "string",
            "minLength": 1
          },
          "valueNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "possibleValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflictsWith": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeatable": {
            "type": "boolean"
          },
          "numArgs": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "argv",
          "summary",
          "category",
          "danger",
          "binding",
          "composition",
          "invocationSchema",
          "arguments",
          "argvBindings",
          "inputSchemas",
          "payloadSchema",
          "resultSchema",
          "outputBoundary",
          "pagination",
          "effects",
          "approvalContract",
          "handleTransitions",
          "recovery",
          "targets",
          "operationalAliases",
          "hiddenFromIntentSearch"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": ["read", "navigation", "write", "maintenance", "debug"]
          },
          "danger": {
            "enum": ["none", "review", "high"]
          },
          "binding": {
            "enum": ["passthrough", "overlay", "object", "none", "raw"]
          },
          "composition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["constants", "mappings"],
                "properties": {
                  "base": {
                    "type": "object",
                    "required": ["argument"],
                    "properties": {
                      "argument": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "constants": {
                    "type": "object"
                  },
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "argument",
                        "field",
                        "transform",
                        "required"
                      ],
                      "properties": {
                        "argument": {
                          "type": "string",
                          "minLength": 1
                        },
                        "field": {
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "enum": [
                            "identity",
                            "trim-string",
                            "path-string",
                            "context-ref",
                            "context-ref-array",
                            "file-id"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "default": {}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "invocationSchema": {
            "type": "object"
          },
          "argvBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "kind",
                "token",
                "takesValue",
                "required",
                "valueNames"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": ["option", "positional"]
                },
                "token": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "shortToken": {
                  "type": "string",
                  "pattern": "^-"
                },
                "takesValue": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "valueNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "payloadSchema": {
            "type": "object"
          },
          "resultSchema": {
            "type": "object"
          },
          "outputBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy"],
            "properties": {
              "strategy": {
                "enum": ["fixed", "cursor", "offset", "limit", "file", "raw"]
              },
              "section": { "type": "string" },
              "defaultLimit": { "type": "integer", "minimum": 1 },
              "maxLimit": { "type": "integer", "minimum": 1 },
              "cursorInput": { "type": "string" },
              "continuation": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "truncatedField": { "type": "string" },
              "fileField": { "type": "string" }
            }
          },
          "pagination": {
            "enum": ["none", "cursor", "file"]
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "stateChanged", "description"],
              "properties": {
                "kind": {
                  "enum": [
                    "none",
                    "ui-navigation",
                    "ephemeral-file",
                    "workflow-control",
                    "zotero-library",
                    "product-store",
                    "cache-maintenance",
                    "graph-metrics-maintenance",
                    "debug-repair"
                  ]
                },
                "stateChanged": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "approvalContract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "timing", "scope"],
            "properties": {
              "kind": {
                "enum": ["none", "zotero-ui-required", "conditional"]
              },
              "timing": {
                "enum": [
                  "none",
                  "before-command",
                  "during-execution",
                  "apply-back"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "handleTransitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "handle",
                "direction",
                "required",
                "condition",
                "lifetime"
              ],
              "properties": {
                "handle": {
                  "enum": [
                    "itemRef",
                    "noteRef",
                    "collectionKey",
                    "workflowRunId",
                    "submissionId",
                    "queueId",
                    "skillRunId",
                    "agentRunId",
                    "agentRequestId",
                    "permissionRequestId",
                    "eventId",
                    "fileId",
                    "productId",
                    "operationId",
                    "applyReceipt"
                  ]
                },
                "direction": {
                  "enum": ["consume", "produce"]
                },
                "required": {
                  "type": "boolean"
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "lifetime": {
                  "enum": [
                    "caller-owned",
                    "response",
                    "short-lived",
                    "one-shot"
                  ]
                }
              }
            }
          },
          "recovery": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "stateCheck", "requiresHandles", "action"],
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "stateCheck": {
                  "enum": ["none", "command-result", "caller-held-handle"]
                },
                "requiresHandles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "nextCommand": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "target"],
              "properties": {
                "kind": {
                  "enum": ["capability", "endpoint", "service"]
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "operationalAliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hiddenFromIntentSearch": {
            "type": "boolean"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "token",
                "takesValue",
                "required",
                "global",
                "help",
                "valueNames",
                "possibleValues",
                "conflictsWith",
                "repeatable",
                "aliases",
                "defaultValues"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": ["option", "positional"]
                },
                "token": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "shortToken": {
                  "type": "string",
                  "pattern": "^-"
                },
                "takesValue": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "global": {
                  "type": "boolean"
                },
                "help": {
                  "type": "string",
                  "minLength": 1
                },
                "longHelp": {
                  "type": "string",
                  "minLength": 1
                },
                "valueNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "possibleValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "conflictsWith": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "repeatable": {
                  "type": "boolean"
                },
                "numArgs": {
                  "type": "string",
                  "minLength": 1
                },
                "env": {
                  "type": "string",
                  "minLength": 1
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "defaultValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "inputSchemas": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token",
                "required",
                "requiredWhen",
                "schemaSource",
                "schema",
                "examples"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "requiredWhen": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "schema": {
                  "type": "object"
                },
                "schemaSource": {
                  "enum": ["inline", "target-capability", "composition"]
                },
                "examples": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "value", "prerequisites"],
                    "properties": {
                      "kind": {
                        "enum": ["shape-only", "executable"]
                      },
                      "value": {},
                      "prerequisites": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
