# 全部 submodule 都是固定版本 gitlink 基线：update = none 禁止 git 自动移动它们。
# `git submodule update --remote` 因此不会改变任何基线；升级走显式流程
# （取目标 tag → 核对 commit → checkout → 提交 gitlink），见 AGENTS.md。
[submodule "skills_builtin/literature-explainer"]
	path = skills_builtin/literature-explainer
	url = https://github.com/leike0813/agent-skills
	branch = skill/literature-explainer
	update = none
[submodule "skills_builtin/literature-analysis"]
	path = skills_builtin/literature-analysis
	url = https://github.com/leike0813/agent-skills
	branch = skill/literature-analysis
	update = none
[submodule "skills_builtin/literature-translator"]
	path = skills_builtin/literature-translator
	url = https://github.com/leike0813/agent-skills
	branch = skill/literature-translator
	update = none
[submodule "references/Skill-Runner"]
	path = references/Skill-Runner
	url = https://github.com/leike0813/Skill-Runner
	update = none
[submodule "references/Zotero-7"]
	path = references/Zotero-7
	url = https://github.com/zotero/zotero.git
	shallow = true
	update = none
[submodule "references/Zotero-9"]
	path = references/Zotero-9
	url = https://github.com/zotero/zotero.git
	shallow = true
	update = none
[submodule "references/Zotero-10"]
	path = references/Zotero-10
	url = https://github.com/zotero/zotero.git
	shallow = true
	update = none
