# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Scope decision (2026-10-02): analyze the architectural core only —
# src, packages, rust, contracts, workflows_builtin, skills_src, scripts, tools, typings.
# Everything else is excluded.

# --- Out of scope: top-level directories ---

# Zotero 源码 submodule 基线（152M，外部参考实现）
references/

# esbuild 构建产物与静态资源
addon/

# OpenSpec 规格与变更记录（5949 个文件）
openspec/

# 开发过程工件、审计报告、playbook
artifacts/

# Docusaurus 文档站
