{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_50_kg_enrichment.schema.json",
  "title": "Stage 50 KG enrichment payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_details",
    "existing_topic_relation_proposals",
    "prospective_topic_relation_proposals",
    "topic_matching_terms"
  ],
  "properties": {
    "concept_details": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "topic-domain.schema.json#/$defs/ConceptCard"
          },
          {
            "properties": {
              "confidence": {
                "$ref": "topic-domain.schema.json#/$defs/ConceptConfidence"
              },
              "aliases": {
                "maxItems": 8,
                "uniqueItems": true
              },
              "definition": {
                "minLength": 1
              },
              "topic_relevance": {
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "existing_topic_relation_proposals": {
      "type": "array",
      "items": {
        "$ref": "topic-domain.schema.json#/$defs/ExistingTopicRelationProposal"
      }
    },
    "prospective_topic_relation_proposals": {
      "type": "array",
      "items": {
        "$ref": "topic-domain.schema.json#/$defs/TopicRelationProposal"
      }
    },
    "topic_matching_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_terms",
        "must_have_terms",
        "methods",
        "exclude_terms"
      ],
      "properties": {
        "include_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_have_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "concept_details": [
        {
          "label": "Object detection",
          "aliases": ["目标检测"],
          "concept_type": "task",
          "definition": "在图像或视频中定位并识别目标，是 Computer Vision 的下位任务。",
          "topic_relevance": "当前 workset 覆盖较多的 Computer Vision 子域。"
        }
      ],
      "existing_topic_relation_proposals": [
        {
          "relation_type": "target_is_narrower_topic_candidate",
          "target_topic_id": "object-detection",
          "target_topic_title": "Object Detection",
          "confidence": 0.88,
          "rationale": "Object Detection 是 Computer Vision 的下位任务；即使当前 workset 偏向检测，Computer Vision 的语义范围仍更宽。",
          "source_paper_refs": ["1:DETR"]
        }
      ],
      "prospective_topic_relation_proposals": [
        {
          "target_topic_seed": "visual representation learning",
          "relation_type": "target_is_narrower_topic_candidate"
        }
      ],
      "topic_matching_terms": {
        "include_terms": [
          "computer vision",
          "object detection",
          "segmentation"
        ],
        "must_have_terms": ["visual perception"],
        "methods": ["query-based detection", "mask prediction"],
        "exclude_terms": ["computer graphics rendering"]
      }
    }
  ]
}
