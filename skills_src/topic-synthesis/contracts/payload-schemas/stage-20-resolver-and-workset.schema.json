{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.stage_20_resolver_and_workset.schema.json",
  "title": "Stage 20 resolver and workset payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolver", "resolver_reasoning", "operation_intent"],
  "properties": {
    "resolver": {
      "$ref": "client-topic-workbench.schema.json#/$defs/TopicResolverProposal"
    },
    "resolver_reasoning": {
      "type": "string"
    },
    "operation_intent": {
      "enum": ["create", "unknown"]
    }
  },
  "examples": [
    {
      "resolver": {
        "tag": {
          "and": ["object-detection", "detr"]
        },
        "combine": "union"
      },
      "resolver_reasoning": "",
      "operation_intent": "create"
    }
  ]
}
