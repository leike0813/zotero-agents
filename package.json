{
  "name": "zotero-agents",
  "type": "module",
  "version": "0.8.0",
  "description": "An all-in-one agentic workbench for your Zotero library",
  "config": {
    "addonName": "Zotero Agents",
    "addonID": "zotero-skills@leike0813@gmail.com",
    "addonRef": "zotero-skills",
    "addonInstance": "ZoteroSkills",
    "prefsPrefix": "extensions.zotero.zotero-skills"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leike0813/zotero-agents.git"
  },
  "author": "Joshua Reed",
  "bugs": {
    "url": "https://github.com/leike0813/zotero-agents/issues"
  },
  "homepage": "https://github.com/leike0813/zotero-agents#readme",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "tsx scripts/run-zotero-start-with-mock.ts start:raw",
    "start:direct": "tsx scripts/run-zotero-direct.ts",
    "start:direct:build": "tsx scripts/run-zotero-direct.ts --build",
