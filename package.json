    "check:zotero-bridge-cli-governance": "node scripts/host-bridge-cli-release-governance.mjs status --json",
    "bump:zotero-bridge-cli": "node scripts/host-bridge-cli-release-governance.mjs bump-patch --write",
    "record:zotero-bridge-cli-binaries": "node scripts/host-bridge-cli-release-governance.mjs record-binaries --write",
    "sync:host-bridge-cli-prebuilds": "tsx scripts/sync-host-bridge-cli-prebuilds.ts",
    "stage:host-bridge-cli-prebuilds": "tsx scripts/stage-host-bridge-cli-prebuilds.ts",
    "sync:gitee-release": "tsx scripts/sync-gitee-publication.ts",
    "package:acp-ws-bridge": "node scripts/package-acp-ws-bridge.mjs",
    "prebuild:acp-ws-bridge": "node scripts/build-acp-ws-bridge.mjs",
