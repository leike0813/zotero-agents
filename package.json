    "build": "npm run check:synthesis-engine && npm run check:synthesis-contracts && npm run check:synthesis-repository && npm run check:synthesis-application && npm run check:synthesis-service && npm run build:synthesis-service && zotero-plugin build && tsc --noEmit",
    "build:help-docs": "tsx scripts/build-help-docs.ts",
    "check:help-docs": "tsx scripts/build-help-docs.ts --check",
    "harness:ui": "tsx scripts/ui-harness-serve.ts",
    "clear:acp-chat": "tsx scripts/clear-acp-chat-records.ts",
    "clear:acp-skills": "tsx scripts/clear-acp-skills-records.ts",
    "clear:skillrunner": "tsx scripts/clear-skillrunner-records.ts",
    "test:node:ui:harness": "tsx node_modules/mocha/bin/mocha \"test/ui/156-ui-readonly-harness.test.ts\" --require test/setup/zotero-mock.ts",
    "test:literature-deep-reading:detr-visual": "tsx node_modules/mocha/bin/mocha \"test/ui/157-literature-deep-reading-detr-visual.test.ts\" --require test/setup/zotero-mock.ts --exit",
