    "benchmark:synthesis-rust-complex-kernels": "tsx scripts/benchmark-synthesis-rust-complex-kernels.ts",
    "package:synthesis-sidecar-runtime": "tsx scripts/package-synthesis-sidecar-runtime.ts",
