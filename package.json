    "test:node:lite": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw lite",
    "test:node:full": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:sharded full",
    "test:node:synthesis-sidecar:stage1": "npm run build:synthesis-rust-sidecar && tsx scripts/run-node-test-shards.ts --suite synthesis-sidecar-stage1",
    "check:synthesis-cross-language-contracts": "tsx scripts/check-synthesis-cross-language-contracts.ts",
    "check:synthesis-durable-foundation-parity": "tsx scripts/check-synthesis-durable-foundation-parity.ts",
    "check:synthesis-typed-application-parity": "tsx scripts/check-synthesis-typed-application-parity.ts",
    "check:synthesis-rust-license-inventory": "tsx scripts/check-synthesis-rust-license-inventory.ts",
    "test:node:core": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:core lite core",
    "test:node:core:full": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:core full core",
    "test:node:ui": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:ui lite ui",
    "test:node:ui:full": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:ui full ui",
    "test:node:workflow": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:workflow lite workflow",
    "test:node:workflow:full": "tsx scripts/run-zotero-test-with-mock.ts test:node:raw:workflow full workflow",
    "test:node:raw:sharded": "tsx scripts/run-node-test-shards.ts",
    "test:node:raw:core": "tsx node_modules/mocha/bin/mocha \"test/core/**/*.test.ts\" \"test/node/core/**/*.test.ts\" --require test/setup/zotero-mock.ts",
    "test:node:raw:ui": "tsx node_modules/mocha/bin/mocha \"test/ui/**/*.test.ts\" --require test/setup/zotero-mock.ts",
    "test:node:raw:workflow": "tsx node_modules/mocha/bin/mocha \"test/workflow-*/**/*.test.ts\" --require test/setup/zotero-mock.ts",
    "test:node:raw": "tsx node_modules/mocha/bin/mocha \"test/**/*.test.ts\" --ignore \"test/zotero/**/*.test.ts\" --require test/setup/zotero-mock.ts",
    "test:synthesis:invariants": "tsx node_modules/mocha/bin/mocha \"test/core/121-synthesis-reference-sidecar-index.test.ts\" \"test/core/125-synthesis-tab-ui.test.ts\" \"test/core/129-synthesis-layer-integration.test.ts\" \"test/core/132-topic-synthesis-structured-artifact-contract.test.ts\" \"test/core/143-synthesis-reference-sidecar-citation-graph.test.ts\" \"test/core/146-synthesis-repository-foundation.test.ts\" \"test/core/151-synthesis-reference-resolution-matcher.test.ts\" \"test/core/152-synthesis-invariant-guards.test.ts\" \"test/core/168-synthesis-sidecar-boundary.test.ts\" --require test/setup/zotero-mock.ts --timeout 10000 --grep \"Synthesis invariant guards|\\[inv\\.\" --exit",
    "mock:skillrunner": "tsx scripts/mock-skillrunner-serve.ts",
    "update-deps": "npm update --save",
    "docs:dev": "cd site && npx docusaurus start",
    "docs:build": "cd site && npx docusaurus build",
    "docs:serve": "cd site && npx docusaurus serve"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "graphology": "^0.26.0",
