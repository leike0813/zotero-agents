    "check:host-bridge-cli-prebuild-freshness": "node scripts/check-host-bridge-cli-prebuild-freshness.mjs",
    "check:zotero-librarian-profile": "tsx scripts/check-host-bridge-skill-packages.ts profiles/hermes/zotero-librarian/skills/zotero-librarian",
    "check:zotero-library-agent-bundle": "tsx scripts/check-host-bridge-skill-packages.ts skills_builtin/zotero-library-agent skills_builtin/zotero-library-query skills_builtin/zotero-literature-acquisition skills_builtin/zotero-literature-analysis skills_builtin/zotero-research-synthesis skills_builtin/zotero-library-curation",
    "check:content-package-release": "tsx scripts/check-content-package-release.ts",
    "check:content-package-mirror": "tsx scripts/check-content-package-release.ts --check-mirror",
    "build:content-feed": "tsx scripts/build-content-package-feed.ts",
    "bump:content-package": "tsx scripts/bump-content-package-version.ts",
    "release:content-package": "tsx scripts/prepare-content-package-release.ts",
    "render:host-bridge-content": "tsx scripts/render-host-bridge-surfaces.ts --content-only",
    "check:host-bridge-content": "tsx scripts/render-host-bridge-surfaces.ts --check --content-only && tsx scripts/check-host-bridge-agent-language.ts",
    "check:host-bridge-review-mirror": "tsx scripts/host-bridge-review-mirror.ts check --target=artifact/host-bridge-review",
    "render:host-bridge-surface": "npm run render:host-bridge-content && tsx scripts/render-host-bridge-release-set.ts",
    "check:host-bridge-surface": "npm run check:host-bridge-content && tsx scripts/render-host-bridge-release-set.ts --check",
