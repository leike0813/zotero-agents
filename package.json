    "release:host-bridge:dispatch": "tsx scripts/dispatch-host-bridge-release.ts",
    "prepare:host-bridge-release": "tsx scripts/prepare-host-bridge-release.ts --write",
    "inspect:zotero-bridge-wrapper-version": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-bridge-cli",
    "bump:zotero-bridge-wrapper": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-bridge-cli --bump",
    "inspect:zotero-librarian-profile-version": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-librarian",
    "bump:zotero-librarian-profile": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-librarian --bump",
    "inspect:zotero-library-agent-bundle-version": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-library-agent",
    "bump:zotero-library-agent-bundle": "tsx scripts/host-bridge-surface-version.ts --surface=zotero-library-agent --bump",
