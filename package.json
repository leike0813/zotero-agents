    "check:synthesis-repository": "tsc -p packages/synthesis-repository/tsconfig.json --noEmit",
    "check:synthesis-application": "tsc -p packages/synthesis-application/tsconfig.json --noEmit",
    "check:synthesis-service": "tsc -p apps/synthesis-service/tsconfig.json --noEmit",
    "build:synthesis-service": "tsc -p apps/synthesis-service/tsconfig.build.json",
    "build:synthesis-rust-sidecar": "cargo +nightly-2026-07-25 build --workspace --locked --manifest-path native/synthesis-sidecar/Cargo.toml",
